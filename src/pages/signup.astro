---
import MainLayout from "../layouts/MainLayout.astro";
import AuthForm from "../components/AuthForm.astro";
import Icon from "../components/Icon.astro";
---

<MainLayout title="Create an account" privatePage={true}
  ><section class="auth-section auth-signup">
    <div class="container signup-grid">
      <div class="auth-intro">
        <p class="eyebrow" style="color:#DFC1C5">
          B2B connections start here
        </p><h1>Buy. Sell.<br />Build something together.</h1><p class="mt-6">
          Create an account to source products or sell for your business.
          Connect with business buyers and suppliers through clear enquiries,
          quotes and conversations.
        </p>
      </div>
      <div class="card auth-card">
        <span class="auth-emblem"><Icon name="account" size={26} /></span>
        <p class="eyebrow">Join Salam Sourcing B2B Marketplace</p><h2>
          Create your account
        </h2><p class="help-text">
          Anyone can register. Use the same account on the website and app to
          manage your business sourcing.
        </p><AuthForm mode="signup" /><p class="auth-foot">
          Already have an account? <a
            class="text-link"
            href={"/login?next=" +
              encodeURIComponent(
                Astro.url.searchParams.get("next") ?? "/discover",
              )}>Log in</a
          >
        </p>
      </div>
    </div>
  </section></MainLayout
>
