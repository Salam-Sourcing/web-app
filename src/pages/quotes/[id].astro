---
import AppLayout from "../../layouts/AppLayout.astro";
import QuoteCard from "../../components/QuoteCard.astro";
import { requireWorkspace } from "../../lib/server/access";
import { enquiry } from "../../lib/server/procurement";
import { checked } from "../../lib/server/catalog";
import { positiveId, AccessError } from "../../lib/security";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
const result = await state.client
  .from("quotes")
  .select("*")
  .eq("id", id)
  .maybeSingle();
checked(result.error);
if (!result.data)
  throw new AccessError(404, "quote_unavailable", "This quote is unavailable.");
const q = result.data,
  e = await enquiry(state, q.enquiry_id);
const profile = await state.client.rpc("get_public_company_profile", {
  p_company_id: q.supplier_company_id,
});
checked(profile.error);
---

<AppLayout
  title={"Quote #" + id}
  active="enquiries"
  state={state}
  description={e.title}
  ><a slot="actions" class="button secondary" href={"/enquiries/" + e.id}
    >Back to enquiry</a
  ><div class="reading">
    <QuoteCard
      state={state}
      quote={q}
      enquiry={e}
      profile={profile.data?.[0] ?? null}
    />
  </div></AppLayout
>
