---
import AppLayout from "../../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { quoteBundle } from "../../../lib/server/procurement";
import { positiveId } from "../../../lib/security";
import {
  quoteOrder,
  money,
  dateLabel,
  expired,
} from "../../../lib/procurement";
import { quantityLabel } from "../../../lib/procurement";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id),
  b = await quoteBundle(state, id),
  order = Astro.url.searchParams.get("order") ?? "newest",
  quotes = quoteOrder(b.quotes, order);
const rows = [
  [
    "Status",
    (q: (typeof quotes)[number]) =>
      q.status + (expired(q.valid_until) ? " (expired)" : ""),
  ],
  [
    "Total price",
    (q: (typeof quotes)[number]) => money(q.total_price, q.currency),
  ],
  [
    "Unit price",
    (q: (typeof quotes)[number]) => money(q.price_per_unit, q.currency),
  ],
  [
    "Lead time",
    (q: (typeof quotes)[number]) =>
      q.lead_time_days === null ? "Not supplied" : q.lead_time_days + " days",
  ],
  [
    "Reviews",
    (q: (typeof quotes)[number]) => {
      const p = b.profiles.find((p) => p.id === q.supplier_company_id)?.profile;
      return !p
        ? "Unavailable"
        : p.total_reviews
          ? Number(p.average_rating).toFixed(1) + "/5 (" + p.total_reviews + ")"
          : "No reviews yet";
    },
  ],
  [
    "Payment terms",
    (q: (typeof quotes)[number]) => q.payment_terms || "Not supplied",
  ],
  [
    "Shipping terms",
    (q: (typeof quotes)[number]) => q.shipping_terms || "Not supplied",
  ],
  ["Valid until", (q: (typeof quotes)[number]) => dateLabel(q.valid_until)],
  ["Notes", (q: (typeof quotes)[number]) => q.notes || "Not supplied"],
] as const;
---

<AppLayout
  title="Compare quotes"
  active="enquiries"
  state={state}
  description={b.enquiry.title}
>
  <a slot="actions" class="button secondary" href={"/enquiries/" + id}
    >Back to enquiry</a
  >
  <div class="card form-stack">
    <p>
      Requested quantity: {quantityLabel(b.enquiry)}. Prices keep their quoted
      currencies; sorting groups by currency without conversion.
    </p>
    <form method="get" class="row-actions">
      <label class="field"
        >Order suppliers<select name="order"
          ><option value="newest" selected={order === "newest"}
            >Newest quote</option
          ><option value="price" selected={order === "price"}
            >Total price within currency</option
          ><option value="lead" selected={order === "lead"}
            >Shortest lead time</option
          ></select
        ></label
      ><button class="button secondary">Apply</button><a
        class="text-link"
        href={"/enquiries/" + id + "/export"}>Export all quotes PDF</a
      >
    </form>
    {
      quotes.length ? (
        <div
          class="table-scroll"
          role="region"
          aria-label="Quote comparison"
          tabindex="0"
        >
          <table class="comparison-table">
            <>
              <thead>
                <tr>
                  <th scope="col">Compare</th>
                  {quotes.map((q) => (
                    <th scope="col">
                      {b.profiles.find((p) => p.id === q.supplier_company_id)
                        ?.profile?.display_name ?? "Supplier unavailable"}
                      <small>
                        Quote #{q.id} · v{q.version}
                      </small>
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rows.map(([label, value]) => (
                  <tr>
                    <th scope="row">{label}</th>
                    {quotes.map((q) => (
                      <td>{value(q)}</td>
                    ))}
                  </tr>
                ))}
                <tr>
                  <th scope="row">Supplier</th>
                  {quotes.map((q) => (
                    <td>
                      {b.profiles.find((p) => p.id === q.supplier_company_id)
                        ?.profile && (
                        <a
                          class="text-link"
                          href={"/suppliers/" + q.supplier_company_id}
                        >
                          View profile
                        </a>
                      )}
                    </td>
                  ))}
                </tr>
                <tr>
                  <th scope="row">Choose quote</th>
                  {quotes.map((q) => (
                    <td>
                      <a class="button secondary" href={"/quotes/" + q.id}>
                        Review & select
                      </a>
                    </td>
                  ))}
                </tr>
              </tbody>
            </>
          </table>
        </div>
      ) : (
        <p>No quotes available to compare.</p>
      )
    }
  </div>
</AppLayout>
