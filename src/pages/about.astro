---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="About us">
  <section class="mx-auto max-w-3xl px-6 py-24 text-center lg:px-8">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-600">
      Our mission
    </p>
    <h1 class="mt-5 text-5xl font-bold tracking-tight text-slate-900">
      Trade should feel human.
    </h1>
    <p class="mt-6 text-lg leading-8 text-slate-600">
      We are building the sourcing platform we wished existed: clear, welcoming,
      and designed to help good businesses find each other.
    </p>
  </section>
</MainLayout>
