---
import AppLayout from "../layouts/AppLayout.astro";
import Icon from "../components/Icon.astro";
import CatalogFeed from "../components/CatalogFeed.astro";
import { requireWorkspace } from "../lib/server/access";
const state = await requireWorkspace(Astro);
const saveSearch = "/account/searches?" + Astro.url.searchParams;
---

<AppLayout
  title="Discover"
  active="discover"
  state={state}
  description="Find products, services and suppliers for your business."
>
  <a slot="actions" class="button secondary" href="/saved"
    ><Icon name="heart" />Saved listings &amp; suppliers</a
  >
  <div class="actions mb-5">
    <a class="text-link" href={saveSearch}>Save these search filters</a>
  </div>
  <CatalogFeed state={state} />
</AppLayout>
