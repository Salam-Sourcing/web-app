---
import { statusLabel } from "../../lib/status-label";
import CompanyAvatar from "../../components/CompanyAvatar.astro";
import { companyPhoto } from "../../lib/server/company-photo";
import Icon from "../../components/Icon.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
import { checked } from "../../lib/server/catalog";
import { listingStatuses, PAGE_SIZE, searchInput } from "../../lib/catalog";
const state = await requireWorkspace(Astro),
  company = state.company,
  canList = state.permissions.includes("listings");
const photo = company
  ? await companyPhoto(state, company.id).catch(() => null)
  : null;
const offset = searchInput(Astro.url.searchParams).offset;
const chosen = Astro.url.searchParams.get("status") ?? "all";
const status = listingStatuses.includes(
  chosen as (typeof listingStatuses)[number],
)
  ? chosen
  : "all";
let rows: {
  id: number;
  name: string;
  status: string;
  updated_at: string;
  listing_images: { id: number }[];
}[] = [];
let count = 0,
  error: string | null = null,
  counts: Record<string, number> = {};
if (company && canList) {
  try {
    const results = await Promise.all(
      listingStatuses.map(async (value) => {
        const result = await state.client
          .from("listings")
          .select("id", { count: "exact", head: true })
          .eq("company_id", company.id)
          .eq("status", value);
        checked(result.error);
        return [value, result.count ?? 0] as const;
      }),
    );
    counts = Object.fromEntries(results);
    let query = state.client
      .from("listings")
      .select("id,name,status,updated_at,listing_images(id)", {
        count: "exact",
      })
      .eq("company_id", company.id);
    if (status !== "all") query = query.eq("status", status);
    const result = await query
      .order("updated_at", { ascending: false })
      .order("id", { ascending: false })
      .range(offset, offset + PAGE_SIZE - 1);
    checked(result.error);
    rows = result.data ?? [];
    count = result.count ?? 0;
  } catch (e) {
    error = e instanceof Error ? e.message : "Unable to load your listings.";
  }
}
---

<AppLayout
  title="Sell"
  description="Build your catalogue and manage your listings."
  active="sell"
  state={state}
>
  <div class="sell-workspace">
    {
      !company ? (
        <section class="card empty-state">
          <>
            <h2>Start with your company</h2>
            <p>Create a company profile to build your catalog.</p>
            <a class="button mt-5" href="/company/new">
              Create company
            </a>
          </>
        </section>
      ) : (
        <>
          <section class="card seller-overview">
            <>
              <div>
                <>
                  <div class="seller-identity">
                    <>
                      <CompanyAvatar
                        name={company.display_name}
                        id={company.id}
                        photo={Boolean(photo)}
                      />
                      <div>
                        <p class="eyebrow">Your seller workspace</p>
                        <h2>{company.display_name}</h2>
                        <p class="help-text">
                          {[
                            company.city,
                            company.province_state,
                            company.country,
                          ]
                            .filter(Boolean)
                            .join(", ")}
                        </p>
                      </div>
                    </>
                  </div>
                </>
              </div>
              <div class="actions">
                <a class="seller-shortcut" href="/company">
                  <Icon name="company" />
                  Company profile
                </a>
                {state.permissions.includes("insights") && (
                  <a class="seller-shortcut" href="/account/insights">
                    <Icon name="insights" />
                    Supplier insights
                  </a>
                )}
              </div>
            </>
          </section>
          {!canList ? (
            <section class="card mt-6">
              <h2>Listing access is restricted</h2>
              <p>
                Your effective company permissions do not include listing
                management. Contact your company administrator.
              </p>
            </section>
          ) : (
            <>
              {company.verification_status !== "verified" && (
                <p class="form-message mt-6">
                  You can save drafts. Verify your company before submitting
                  listings for moderation.
                </p>
              )}
              {!error && (
                <nav
                  class="tab-row seller-status-tabs mt-6"
                  aria-label="Listing status"
                >
                  <a
                    href="/sell"
                    aria-current={status === "all" ? "page" : undefined}
                  >
                    All ({Object.values(counts).reduce((a, b) => a + b, 0)})
                  </a>
                  {listingStatuses.map((value) => (
                    <a
                      href={"/sell?status=" + value}
                      aria-current={status === value ? "page" : undefined}
                    >
                      {statusLabel(value)} ({counts[value] ?? 0})
                    </a>
                  ))}
                </nav>
              )}
              {error ? (
                <section class="card">
                  <p class="form-message" role="alert">
                    {error}
                  </p>
                  <a
                    class="button secondary"
                    href={Astro.url.pathname + Astro.url.search}
                  >
                    Retry
                  </a>
                </section>
              ) : rows.length === 0 ? (
                <section class="card empty-state">
                  <h2>
                    {status === "all"
                      ? "No listings yet"
                      : "No " + status.replaceAll("_", " ") + " listings"}
                  </h2>
                  <p>
                    Start with a manual draft. Only approved listings appear in
                    discovery.
                  </p>
                  <p class="help-text">
                    Use Post an item to start your next listing.
                  </p>
                </section>
              ) : (
                <div class="seller-list">
                  {rows.map((row) => (
                    <article class="card seller-row">
                      <a class="seller-thumbnail" href={"/sell/" + row.id}>
                        {row.listing_images.length > 0 ? (
                          <img
                            data-private-media
                            src={"/api/media/listing/" + row.id}
                            alt=""
                            loading="lazy"
                          />
                        ) : (
                          <span aria-hidden="true">▧</span>
                        )}
                      </a>
                      <div>
                        <h2>
                          <a href={"/sell/" + row.id}>{row.name}</a>
                        </h2>
                        <p class="help-text">
                          Updated{" "}
                          {new Date(row.updated_at).toLocaleDateString("en", {
                            timeZone: "UTC",
                          })}
                        </p>
                      </div>
                      <span
                        class:list={[
                          "badge",
                          "seller-state",
                          row.status === "published" && "success",
                        ]}
                      >
                        {statusLabel(row.status)}
                      </span>
                      <a class="text-link" href={"/sell/" + row.id}>
                        Manage
                      </a>
                    </article>
                  ))}
                </div>
              )}
              <div class="actions justify-center">
                {offset > 0 && (
                  <a
                    class="button secondary"
                    href={
                      "?status=" +
                      status +
                      "&offset=" +
                      Math.max(0, offset - PAGE_SIZE)
                    }
                  >
                    Previous
                  </a>
                )}
                {offset + PAGE_SIZE < count && (
                  <a
                    class="button secondary"
                    href={
                      "?status=" + status + "&offset=" + (offset + PAGE_SIZE)
                    }
                  >
                    Next listings
                  </a>
                )}
              </div>
            </>
          )}
        </>
      )
    }
    {
      company && canList && !error && (
        <a class="button floating-post" href="/sell/new">
          <Icon name="plus" size={22} />
          Post an item
        </a>
      )
    }
  </div>
</AppLayout>
