---
import AppLayout from "../../layouts/AppLayout.astro";
import ListingForm from "../../components/ListingForm.astro";
import { requireWorkspace } from "../../lib/server/access";
import { activeCompany, taxonomy } from "../../lib/server/catalog";
const state = await requireWorkspace(Astro);
if (!state.company) return Astro.redirect("/company/new", 303);
const company = activeCompany(state, undefined, "listings"),
  categories = await taxonomy(state);
---

<AppLayout title="Post an item" active="sell" state={state}
  ><section class="card reading">
    <p class="eyebrow">{company.display_name}</p><h2>Create a listing</h2><p
      class="help-text"
    >
      Product or service · manual drafts · review before publication
    </p>{
      categories.length ? (
        <ListingForm companyId={company.id} categories={categories} />
      ) : (
        <p class="form-message">
          No active categories are available.{" "}
          <a class="text-link" href="/sell/new">
            Retry
          </a>{" "}
          or contact support.
        </p>
      )
    }
  </section></AppLayout
>
