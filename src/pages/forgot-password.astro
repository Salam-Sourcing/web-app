---
import MainLayout from "../layouts/MainLayout.astro";
import AuthForm from "../components/AuthForm.astro";
import Icon from "../components/Icon.astro";
---

<MainLayout title="Reset your password" privatePage={true}
  ><section class="container narrow auth-section">
    <div class="card auth-card">
      <span class="auth-emblem"><Icon name="lock" size={26} /></span>
      <p class="eyebrow">Account recovery</p><h1>Forgot your password?</h1><p>
        We'll send a link to help you reset it. Open the link in the browser
        where you request it.
      </p><AuthForm mode="reset" /><p class="auth-foot">
        <a class="text-link" href="/login">Back to log in</a>
      </p>
    </div>
  </section></MainLayout
>
