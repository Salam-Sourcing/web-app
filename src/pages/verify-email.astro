---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Check your email" privatePage={true}
  ><section class="container narrow section">
    <div class="card">
      <p class="eyebrow">One more step</p><h1>Check your email.</h1><p>
        If your account needs confirmation, use the link in your email to
        continue. Open it in the browser where you signed up.
      </p><p>
        Check your spam folder too. If you already have an account, log in or
        recover your password.
      </p><div class="actions">
        <a class="button" href="/login">Log in</a><a
          class="text-link"
          href="/forgot-password">Recover account</a>
      </div>
    </div>
  </section></MainLayout
>
