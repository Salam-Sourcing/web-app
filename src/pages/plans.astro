---
import MainLayout from "../layouts/MainLayout.astro";
import PlanComparison from "../components/PlanComparison.astro";
---

<MainLayout
  title="Subscription plans"
  description="Preview Starter, Growth and Business for Salam Sourcing B2B Marketplace. Compare proposed CAD pricing and features. Paid plans and trials are not available to activate yet."
>
  <section class="container plans-section">
    <div class="plans-intro">
      <p class="eyebrow">Room for your business to grow</p><h1>
        Simple plans for business.
      </h1><p>
        Start small, grow your catalogue and bring your team together. Explore
        our proposed company plans for Salam Sourcing B2B Marketplace.
      </p>
    </div>
    <PlanComparison />
    <div class="actions justify-center">
      <a class="button" href="/signup">Create an account</a><a
        class="text-link"
        href="/help">Contact support</a
      >
    </div>
  </section>
</MainLayout>
