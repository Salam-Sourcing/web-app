---
import MessageAttachment from "../../components/MessageAttachment.astro";
import Icon from "../../components/Icon.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
import {
  conversation,
  enquiry,
  messagePage,
  companySummaries,
} from "../../lib/server/procurement";
import { dateLabel, quantityLabel } from "../../lib/procurement";
import { positiveId } from "../../lib/security";
import { MESSAGE_LIMIT } from "../../lib/client-contracts";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id),
  cv = await conversation(state, id),
  e = await enquiry(state, cv.enquiry_id),
  page = await messagePage(state, id, new URLSearchParams());
const otherId =
  cv.buyer_company_id === state.company?.id
    ? cv.supplier_company_id
    : cv.buyer_company_id;
const companies = otherId ? await companySummaries(state, [otherId]) : [],
  other = companies[0];
---

<AppLayout
  title={other?.display_name ?? "Conversation"}
  active="messages"
  state={state}
  description={"Enquiry #" + e.id}
>
  <div slot="actions" class="row-actions">
    {
      other && (
        <a class="button secondary" href={"/suppliers/" + otherId}>
          View company profile
        </a>
      )
    }
    <a class="button secondary" href="/messages">All messages</a>
  </div>
  <section
    class="card thread"
    data-thread
    data-conversation={id}
    data-company={state.company!.id}
    data-more={page.hasMore}
    data-open={cv.status === "open"}
  >
    <div class="thread-context">
      <div>
        <a class="text-link" href={"/enquiries/" + e.id}>{e.title}</a><p
          class="help-text"
        >
          {quantityLabel(e)} · {e.currency}
        </p>
      </div>{
        e.listing_id && (
          <a class="text-link" href={"/listings/" + e.listing_id}>
            Product / service
          </a>
        )
      }
    </div>
    <p class="help-text" data-live-status role="status">
      Connecting to updates…
    </p>
    <button
      class="button secondary older-button"
      type="button"
      data-older
      hidden={!page.hasMore}>Load older messages</button
    >
    <div class="message-history" data-history aria-label="Conversation history">
      {
        page.rows.map((m) => (
          <article
            class:list={["message-bubble", { outgoing: m.outgoing }]}
            data-message-id={m.id}
            data-sent-at={m.sent_at}
          >
            {m.content && <p class="preserve-lines">{m.content}</p>}
            {m.attachments.map((a) => (
              <MessageAttachment attachment={a} />
            ))}
            {!m.content && !m.attachments.length && (
              <p class="muted">Attachment processing or unavailable.</p>
            )}
            <small>
              <time datetime={m.sent_at}>{dateLabel(m.sent_at)}</time>
              {m.outgoing ? " · " + (m.seen ? "Seen" : "Sent") : ""}
              {!m.outgoing && (
                <a
                  class="chat-icon-button message-report"
                  href={"/account/report?type=message&id=" + m.id}
                  aria-label="Report message"
                  title="Report message"
                >
                  <Icon name="flag" size={18} />
                </a>
              )}
            </small>
          </article>
        ))
      }
      {
        !page.rows.length && (
          <p data-empty-thread class="muted">
            Start your conversation below.
          </p>
        )
      }
    </div>
    {
      cv.status === "open" ? (
        <div class="thread-composers">
          <>
            <form data-send-form class="form-stack">
              <>
                <label class="sr-only" for="chat-message">
                  Message
                </label>
                <div class="chat-composer-input">
                  <>
                    <button
                      class="chat-icon-button attachment-trigger"
                      type="button"
                      data-attachment-open
                      aria-label="Attach a file"
                      title="Attach a file"
                      aria-haspopup="dialog"
                      aria-controls="chat-attachment-dialog"
                    >
                      <Icon name="paperclip" size={22} />
                    </button>
                    <textarea
                      id="chat-message"
                      name="content"
                      maxlength={MESSAGE_LIMIT}
                      rows="1"
                      required
                      placeholder="Message…"
                    />
                    <button
                      class="chat-icon-button chat-send-button"
                      type="submit"
                      data-send
                      disabled
                      aria-label="Send message"
                      title="Send message"
                    >
                      <Icon name="send" size={22} />
                    </button>
                  </>
                </div>
                <button
                  class="button secondary chat-retry-button"
                  type="button"
                  data-retry
                  hidden
                >
                  Retry same message
                </button>
                <p data-form-message hidden role="status" />
              </>
            </form>
            <dialog
              id="chat-attachment-dialog"
              class="chat-attachment-dialog"
              data-attachment-dialog
              aria-labelledby="chat-attachment-title"
            >
              <>
                <header class="chat-attachment-header">
                  <h2 id="chat-attachment-title">Send an attachment</h2>
                  <button
                    type="button"
                    class="chat-icon-button"
                    data-attachment-close
                    aria-label="Close attachment popup"
                    title="Close"
                  >
                    <Icon name="close" />
                  </button>
                </header>
                <form class="form" data-file-form data-kind="message">
                  <>
                    <input type="hidden" name="target_id" value={id} />
                    <input
                      type="hidden"
                      name="company_id"
                      value={state.company!.id}
                    />
                    <label class="field">
                      File
                      <input
                        type="file"
                        accept="image/jpeg,image/png,image/webp,application/pdf"
                        required
                      />
                    </label>
                    <label class="field">
                      Caption (optional)
                      <textarea
                        name="caption"
                        maxlength={MESSAGE_LIMIT}
                        rows="2"
                        placeholder="Add a message about this file…"
                      />
                    </label>
                    <p class="help-text">
                      JPEG, PNG, WebP or PDF, up to 10 MB.
                    </p>
                    <button type="submit" class="button">
                      Send attachment
                    </button>
                    <p data-form-message hidden role="status" />
                  </>
                </form>
              </>
            </dialog>
          </>
        </div>
      ) : (
        <p class="form-message">
          This conversation is archived. Its history remains available.
        </p>
      )
    }
  </section>
</AppLayout>
<script>
  import { bindThread } from "../../scripts/messages";
  import { bindProcurementForms } from "../../scripts/procurement";
  bindThread();
  bindProcurementForms();
</script>
