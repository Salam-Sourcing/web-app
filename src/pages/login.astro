---
import MainLayout from "../layouts/MainLayout.astro";
import AuthForm from "../components/AuthForm.astro";
import Icon from "../components/Icon.astro";
---

<MainLayout title="Log in" privatePage={true}
  ><section class="auth-section container narrow">
    <div class="card auth-card">
      <span class="auth-emblem"><Icon name="lock" size={26} /></span>
      <p class="eyebrow">Welcome back</p><h1>Good to see you again.</h1><p>
        Log in to your Salam Sourcing B2B Marketplace account.
      </p>
      {
        Astro.url.searchParams.get("notice") === "logout-pending" && (
          <p class="form-message">
            Signed out on this browser. Remote session revocation could not be
            confirmed; retry when connected.
          </p>
        )
      }
      <AuthForm mode="login" /><p class="auth-foot">
        New to Salam Sourcing B2B Marketplace? <a
          class="text-link"
          href={"/signup?next=" +
            encodeURIComponent(
              Astro.url.searchParams.get("next") ?? "/discover",
            )}>Create an account</a
        >
      </p>
    </div>
  </section></MainLayout
>
