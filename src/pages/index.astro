---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Source with confidence">
  <section class="bg-gradient-to-br from-brand-50 via-white to-white">
    <div
      class="mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-[1.1fr_0.9fr] lg:items-center lg:px-8"
    >
      <div>
        <p
          class="mb-5 text-sm font-bold uppercase tracking-[0.2em] text-brand-600"
        >
          Trade made simple
        </p>
        <h1
          class="max-w-3xl text-5xl font-bold tracking-tight text-slate-900 sm:text-6xl"
        >
          Find products your customers will love.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
          Salam Sourcing brings ambitious retailers and trusted suppliers
          together in one transparent marketplace.
        </p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a
            href="/marketplace"
            class="rounded-xl bg-brand-600 px-6 py-3 font-semibold text-white hover:bg-brand-700"
            >Explore marketplace</a
          >
          <a
            href="/about"
            class="rounded-xl border border-slate-200 bg-white px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50"
            >How it works</a
          >
        </div>
      </div>
      <div
        class="rounded-3xl bg-brand-700 p-8 text-white shadow-xl shadow-brand-700/20"
      >
        <p class="text-sm font-medium text-brand-100">A better way to grow</p>
        <p class="mt-4 text-3xl font-bold">
          One platform. Endless possibilities.
        </p>
        <div
          class="mt-10 grid grid-cols-2 gap-6 border-t border-brand-500 pt-6"
        >
          <div>
            <p class="text-3xl font-bold">10k+</p><p
              class="mt-1 text-sm text-brand-100"
            >
              Products to discover
            </p>
          </div>
          <div>
            <p class="text-3xl font-bold">120+</p><p
              class="mt-1 text-sm text-brand-100"
            >
              Global categories
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-8">
    <div class="grid gap-8 md:grid-cols-3">
      {
        [
          [
            "Discover",
            "Browse a curated catalog built for independent and growing retailers.",
          ],
          [
            "Connect",
            "Meet reliable suppliers and start conversations directly.",
          ],
          [
            "Grow",
            "Build a resilient product range with tools that work for you.",
          ],
        ].map(([heading, text], index) => (
          <article class="rounded-2xl border border-slate-200 bg-white p-7">
            <span class="text-sm font-bold text-brand-600">0{index + 1}</span>
            <h2 class="mt-4 text-xl font-bold text-slate-900">{heading}</h2>
            <p class="mt-3 leading-7 text-slate-600">{text}</p>
          </article>
        ))
      }
    </div>
  </section>
</MainLayout>
