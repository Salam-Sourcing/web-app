---
import AppLayout from "../../../layouts/AppLayout.astro";
import DealContent from "../../../components/DealContent.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { dealBundle, dealReviewState } from "../../../lib/server/deals";
import { positiveId } from "../../../lib/security";
import type { ReviewState, DealBundle } from "../../../lib/deals";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
let bundle: DealBundle | undefined,
  review: ReviewState | undefined,
  error: string | undefined,
  reviewError: string | undefined;
try {
  bundle = await dealBundle(state, id);
} catch (e) {
  error = (e as Error).message;
}
if (bundle)
  try {
    review = await dealReviewState(state, id);
  } catch (e) {
    reviewError = (e as Error).message;
  }
---

<AppLayout
  title={"Deal #" + id}
  active="enquiries"
  state={state}
  description="Track delivery, share documents and complete your transaction."
>
  <a slot="actions" class="button secondary" href="/deals">All deals</a>
  {
    bundle ? (
      <DealContent
        bundle={bundle}
        review={review}
        reviewError={reviewError}
        company={state.company!.id}
      />
    ) : (
      <section class="card empty-state">
        <>
          <h2>Deal unavailable</h2>
          <p role="alert">{error}</p>
          <div class="actions justify-center">
            <>
              <a class="button secondary" href={Astro.url.pathname}>
                Retry
              </a>
              <a class="text-link" href="/deals">
                Back to deals
              </a>
            </>
          </div>
        </>
      </section>
    )
  }
</AppLayout>
<script>
  import { bindProcurementForms } from "../../../scripts/procurement";
  bindProcurementForms();
</script>
