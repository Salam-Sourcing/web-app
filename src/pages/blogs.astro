---
import MainLayout from "../layouts/MainLayout.astro";
import AppLayout from "../layouts/AppLayout.astro";
import { requireWorkspace, type Workspace } from "../lib/server/access";
import Icon from "../components/Icon.astro";
// Reuse the public-home session check; signed-in readers keep their dock and
// account controls. Requests carrying a session must never share cached HTML.
let state: Workspace | undefined;
if (Astro.request.headers.get("cookie")?.includes("ss-auth")) {
  Astro.locals.authHeaders.set("Cache-Control", "private, no-store");
  try {
    state = await requireWorkspace(Astro);
  } catch {}
}
const Layout = state ? AppLayout : MainLayout;
---

<Layout
  title="Blogs"
  state={state!}
  active="blogs"
  description="News, ideas and sourcing stories from Salam Sourcing B2B Marketplace."
>
  <section class:list={["blogs-page", { "container section": !state }]}>
    {
      !state && (
        <div class="blogs-intro">
          <p class="eyebrow">The Salam Sourcing journal</p>
          <h1>Blogs</h1>
          <p>News, ideas and stories for the businesses behind every trade.</p>
        </div>
      )
    }
    <div class="card blogs-empty">
      <span class="blogs-icon"><Icon name="blogs" size={30} /></span>
      <h2>Our first stories are on their way</h2>
      <p>
        There are no published articles yet. Check back for updates from Salam
        Sourcing.
      </p>
      <a class="text-link" href={state ? "/discover" : "/"}
        >Explore the marketplace <Icon name="arrow" size={18} /></a
      >
    </div>
  </section>
</Layout>

<style>
  .blogs-page {
    max-width: 960px;
  }
  .blogs-intro {
    max-width: 640px;
    margin-bottom: 32px;
  }
  .blogs-intro h1 {
    margin-block: 12px;
  }
  .blogs-intro > p:last-child {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.6;
  }
  .blogs-empty {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 16px;
    padding: clamp(28px, 6vw, 64px);
  }
  .blogs-icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: var(--primary-soft, #f6e9ea);
    color: var(--primary);
  }
  .blogs-empty h2 {
    margin: 0;
  }
  .blogs-empty p {
    max-width: 42ch;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }
  .blogs-empty a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }
</style>
