---
import ListingPrice from "../../components/ListingPrice.astro";
import MediaImage from "../../components/MediaImage.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import SupplierSummary from "../../components/SupplierSummary.astro";
import ListingCard from "../../components/ListingCard.astro";
import { relatedListings } from "../../lib/server/related-listings";
import { companyPhoto } from "../../lib/server/company-photo";
import SaveButton from "../../components/SaveButton.astro";
import { requireWorkspace } from "../../lib/server/access";
import {
  publicListing,
  checked,
  contactAllowed,
} from "../../lib/server/catalog";
import { positiveId } from "../../lib/security";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
let record: Awaited<ReturnType<typeof publicListing>> | undefined,
  error: string | undefined;
try {
  record = await publicListing(state, id);
} catch (e) {
  error = e instanceof Error ? e.message : "This listing is unavailable.";
}
const saved = record
  ? await state.client
      .from("saved_listings")
      .select("id")
      .eq("user_id", state.user.id)
      .eq("listing_id", id)
      .maybeSingle()
  : null;
if (saved) checked(saved.error);
const listing = record?.listing,
  company = record?.company;
const images = listing
  ? [...listing.listing_images].sort(
      (a, b) =>
        Number(b.is_primary) - Number(a.is_primary) ||
        a.display_order - b.display_order,
    )
  : [];
const related = listing
  ? await relatedListings(state, {
      id,
      category: listing.sub_categories?.name ?? "",
    }).catch(() => null)
  : null;
const photo = company
  ? await companyPhoto(state, company.id).catch(() => null)
  : null;
const specs =
  listing?.specifications &&
  typeof listing.specifications === "object" &&
  !Array.isArray(listing.specifications)
    ? Object.entries(listing.specifications)
    : [];
---

<AppLayout
  title={listing?.name ?? "Listing unavailable"}
  active="discover"
  state={state}
>
  {
    listing && company ? (
      <div class="detail-grid" data-view-listing-id={id}>
        <section>
          <div class="gallery-main">
            <span class="image-placeholder" aria-label="No listing image">
              ▧
            </span>
            {images.length > 0 && (
              <MediaImage
                data-private-media
                src={"/api/media/listing/" + id + "?image=" + images[0].id}
                alt={listing.name}
              />
            )}
          </div>
          {images.length > 1 && (
            <div class="gallery-thumbnails">
              {images.map((image, index) => (
                <a
                  href={"/api/media/listing/" + id + "?image=" + image.id}
                  data-gallery-src={
                    "/api/media/listing/" + id + "?image=" + image.id
                  }
                  aria-label={"Show image " + (index + 1)}
                >
                  <MediaImage
                    data-private-media
                    src={"/api/media/listing/" + id + "?image=" + image.id}
                    alt={"Listing image " + (index + 1)}
                  />
                </a>
              ))}
            </div>
          )}
          <section class="card mt-6">
            <p class="preserve-lines mt-4">{listing.description}</p>
            {specs.length > 0 && (
              <>
                <h3 class="mt-6">Specifications</h3>
                <dl>
                  {specs.map(([key, value]) => (
                    <div class="info-row">
                      <dt>{key}</dt>
                      <dd>{String(value ?? "")}</dd>
                    </div>
                  ))}
                </dl>
              </>
            )}
          </section>
        </section>
        <aside class="stack">
          <SupplierSummary company={company} photo={Boolean(photo)} />
          <section class="card">
            <>
              <a
                class="eyebrow supplier-link"
                href={"/suppliers/" + company.id}
              >
                {company.display_name}
              </a>
              <h2 class="mt-3">{listing.name}</h2>

              <p class="help-text mt-3">
                {listing.listing_type} ·{" "}
                {listing.sub_categories?.name ??
                  listing.sub_categories?.categories?.name ??
                  ""}
              </p>
              <div class="mt-5">
                <ListingPrice
                  amount={listing.price_per_unit}
                  currency={listing.currency}
                  unit={listing.unit_of_measure}
                  large
                />
              </div>
              <dl>
                <>
                  <div class="info-row">
                    <>
                      <dt>MOQ</dt>
                      <dd>
                        {listing.minimum_order_quantity ?? "On enquiry"}{" "}
                        {listing.unit_of_measure}
                      </dd>
                    </>
                  </div>
                  <div class="info-row">
                    <>
                      <dt>Lead time</dt>
                      <dd>
                        {listing.estimated_lead_time_days === null
                          ? "On enquiry"
                          : listing.estimated_lead_time_days + " days"}
                      </dd>
                    </>
                  </div>
                  <div class="info-row">
                    <>
                      <dt>Origin</dt>
                      <dd>{listing.origin_country ?? "Not provided"}</dd>
                    </>
                  </div>
                  <div class="info-row">
                    <>
                      <dt>Location</dt>
                      <dd>
                        {[company.city, company.province_state, company.country]
                          .filter(Boolean)
                          .join(", ")}
                      </dd>
                    </>
                  </div>
                </>
              </dl>
              <div class="actions">
                <SaveButton
                  id={id}
                  kind="listing"
                  saved={Boolean(saved?.data)}
                  name={listing.name}
                />
                {contactAllowed(state, company.id) ? (
                  <a
                    class="button"
                    href={
                      "/enquiries/new?listing=" + id + "&supplier=" + company.id
                    }
                  >
                    Contact supplier
                  </a>
                ) : (
                  <p class="help-text">
                    {!state.company
                      ? "Create a company to contact suppliers."
                      : state.company.id === company.id
                        ? "This listing belongs to your company."
                        : "A verified company with procurement permission is required to contact suppliers."}
                  </p>
                )}
              </div>
            </>
          </section>
          <section class="card">
            <>
              <h3>Supplier information</h3>
              <a class="text-link mt-3" href={"/suppliers/" + company.id}>
                View supplier profile
              </a>
              <div class="actions">
                <a
                  class="text-link"
                  href={"/account/report?type=listing&id=" + id}
                >
                  Report listing
                </a>
                {state.company?.id !== company.id && (
                  <a
                    class="text-link"
                    href={"/account/block?company=" + company.id}
                  >
                    Block supplier
                  </a>
                )}
              </div>
            </>
          </section>
        </aside>
      </div>
    ) : (
      <section class="card empty-state">
        <>
          <h2>Listing unavailable</h2>
          <p role="status">{error}</p>
          <div class="actions justify-center">
            <>
              <a class="button secondary" href={Astro.url.pathname}>
                Retry
              </a>
              <a class="text-link" href="/discover">
                Back to Discover
              </a>
            </>
          </div>
        </>
      </section>
    )
  }
  {
    listing && related && related.length > 0 && (
      <section class="related-section">
        <>
          <div class="browse-section-heading">
            <div>
              <>
                <p class="eyebrow">Keep exploring</p>
                <h2>Related products &amp; services</h2>
              </>
            </div>
          </div>
          <div class="catalog-grid">
            {related.map((row) => (
              <ListingCard listing={row} />
            ))}
          </div>
        </>
      </section>
    )
  }
  {
    listing && related === null && (
      <section class="card related-section">
        <>
          <h2>Related products &amp; services</h2>
          <p class="help-text">Related listings couldn’t be loaded.</p>
          <a class="text-link" href={Astro.url.pathname}>
            Retry
          </a>
        </>
      </section>
    )
  }
</AppLayout>
<script>
  import { post } from "../../scripts/forms";
  const id = document.querySelector<HTMLElement>("[data-view-listing-id]")
    ?.dataset.viewListingId;
  if (id) void post("/api/catalog/view", { id }).catch(() => {});
  document
    .querySelectorAll<HTMLAnchorElement>("[data-gallery-src]")
    .forEach((link) =>
      link.addEventListener("click", (event) => {
        event.preventDefault();
        const main =
          document.querySelector<HTMLImageElement>(".gallery-main img");
        if (main) {
          main.hidden = false;
          main.src = link.dataset.gallerySrc!;
        }
      }),
    );
</script>
