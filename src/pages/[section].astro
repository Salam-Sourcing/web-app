---
import AppLayout from "../layouts/AppLayout.astro";
import Icon from "../components/Icon.astro";
import { requireWorkspace } from "../lib/server/access";
const descriptions: Record<string, { title: string; description: string }> = {
  discover: {
    title: "Discover",
    description: "Find products and suppliers for your business.",
  },
  enquiries: {
    title: "Enquiries",
    description: "Request quotes, compare responses and manage your sourcing.",
  },
  sell: {
    title: "Sell",
    description: "Build your catalog and connect with potential buyers.",
  },
  messages: {
    title: "Messages",
    description: "Keep your supplier and buyer conversations together.",
  },
};
const section = Astro.params.section!;
const view = descriptions[section];
if (!view) return Astro.redirect("/account", 303);
const state = await requireWorkspace(Astro);
---

<AppLayout title={view.title} active={section} state={state}
  ><section class="card empty-workspace">
    <div class="empty-icon"><Icon name={section} size={30} /></div><span
      class="badge">Coming to web</span
    ><h2 class="mt-5">{view.description}</h2><p>
      This part of your workspace is being prepared. Continue using it in your
      Salam Sourcing Marketplace app while it's added to the website.
    </p><div class="actions justify-center">
      <a class="button secondary" href="/account">Manage your account</a><a
        class="text-link"
        href="/help">Get help</a
      >
    </div>
  </section></AppLayout
>
