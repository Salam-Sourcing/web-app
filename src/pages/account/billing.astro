---
import { statusLabel } from "../../lib/status-label";
import AppLayout from "../../layouts/AppLayout.astro";
import PlanComparison from "../../components/PlanComparison.astro";
import AccountForm from "../../components/AccountForm.astro";
import { requireWorkspace } from "../../lib/server/access";
import { billing } from "../../lib/server/account";
const state = await requireWorkspace(Astro),
  data = await billing(state),
  c = state.company!,
  sub = data.subscription;
const money = (amount: number, currency: string) =>
  new Intl.NumberFormat("en-CA", {
    style: "currency",
    currency: currency.trim(),
  }).format(amount);
---

<AppLayout
  title="Plans & billing"
  active="account"
  state={state}
  description={"Billing for " + c.display_name}
>
  <a slot="actions" class="text-link" href="/account">Back to Account</a>
  <section class="card">
    <h2>{sub?.subscription_plans?.name ?? "Starter access"}</h2><p>
      {sub ? statusLabel(sub.status) : "No Paid Plan"}
    </p><p>
      {
        sub?.cancel_at_period_end
          ? "Cancellation scheduled · access ends " +
            (sub.end_date ??
              sub.renewal_date ??
              "at the end of the billing period")
          : sub?.renewal_date
            ? "Renews " + sub.renewal_date
            : "Account-managed business billing"
      }
    </p>
    <p class="help-text">
      {
        sub
          ? "Plan limits: " +
            (sub.subscription_plans?.max_users ?? "Unlimited") +
            " users · " +
            (sub.subscription_plans?.max_listings ?? "Unlimited") +
            " listings · " +
            (sub.subscription_plans?.max_enquiries_per_month ?? "Unlimited") +
            " enquiries per month"
          : "Starter limits: 1 user, 3 listings and 5 enquiries per month."
      }
    </p>
    {
      data.pending.length > 0 && (
        <p role="status" class="form-message success">
          A billing request is pending. Wait for it to be reviewed before
          submitting another.
        </p>
      )
    }
    {
      sub && !sub.cancel_at_period_end && !data.pending.length && (
        <AccountForm
          action="billing"
          company={c.id}
          submit="Request cancellation"
        >
          <>
            <input type="hidden" name="request_type" value="cancel" />
            <label class="check-row">
              <input type="checkbox" name="confirm" value="REQUEST" required />
              Request cancellation at the end of the billing period.
            </label>
          </>
        </AccountForm>
      )
    }
  </section>
  <div class="mt-5"><PlanComparison id="account-plan-comparison" /></div>
  <section class="card mt-5">
    <h2>Invoices</h2><p class="help-text">
      Your latest 50 invoices. Requests are reviewed by Salam Sourcing
      Marketplace; submitting a request does not complete payment.
    </p><div
      class="table-scroll"
      tabindex="0"
      role="region"
      aria-label="Invoices"
    >
      <table class="comparison-table">
        <thead
          ><tr
            ><th scope="col">Invoice</th><th scope="col">Amount</th><th
              scope="col">Status</th
            ><th scope="col">Issued</th><th scope="col">Due</th><th scope="col"
              >Paid</th
            ></tr
          ></thead
        ><tbody
          >{
            data.invoices.map((i) => (
              <tr>
                <>
                  <>
                    <th scope="row">{i.invoice_number}</th>
                    <td>{money(i.total_amount, i.currency)}</td>
                    <td>{statusLabel(i.status)}</td>
                    <td>{i.issued_at ?? "—"}</td>
                    <td>{i.due_at ?? "—"}</td>
                    <td>{i.paid_at ?? "—"}</td>
                  </>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>{!data.invoices.length && <p>No invoices yet.</p>}
  </section>
</AppLayout>
