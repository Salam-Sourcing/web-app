---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
import { positiveId } from "../../lib/security";
import { reportReasons, REPORT_LIMIT } from "../../lib/client-contracts";
const state = await requireWorkspace(Astro);
const type = Astro.url.searchParams.get("type");
let id: number | undefined;
try {
  id = positiveId(Astro.url.searchParams.get("id"));
} catch {}
const valid =
  type && ["company", "listing", "message", "review"].includes(type) && id;
---

<AppLayout title="Report a concern" active="account" state={state}
  ><section class="card reading">
    <h2>Help keep sourcing safe</h2>{
      valid ? (
        <form
          class="form"
          data-api-form
          method="post"
          action="/api/safety/report"
        >
          <>
            <input type="hidden" name="target_id" value={id} />
            <input type="hidden" name="target_type" value={type} />
            <label class="field">
              Reason
              <select name="reason">
                {reportReasons.map(([value, label]) => (
                  <option value={value}>{label}</option>
                ))}
              </select>
            </label>
            <label class="field">
              Tell us what happened
              <textarea
                name="description"
                minlength="5"
                maxlength={REPORT_LIMIT}
                required
              />
            </label>
            <p class="form-message" data-form-message role="status" hidden />
            <button class="button" type="submit">
              Submit report
            </button>
          </>
        </form>
      ) : (
        <p>
          Open the listing, company, message or review you want to report and
          choose Report. You can also{" "}
          <a class="text-link" href="mailto:support@salamsourcing.com">
            contact support
          </a>
          .
        </p>
      )
    }<div class="actions">
      <a class="text-link" href="/account/safety">Back to safety</a>
    </div>
  </section></AppLayout
>
