---
import { statusLabel } from "../../lib/status-label";
import ProfileAvatar from "../../components/ProfileAvatar.astro";
import { profilePhoto } from "../../lib/server/profile-photo";
import AppLayout from "../../layouts/AppLayout.astro";
import AccountForm from "../../components/AccountForm.astro";
import { requireWorkspace } from "../../lib/server/access";
import { checked } from "../../lib/server/catalog";
import { fieldMaximum } from "../../lib/client-contracts";
const state = await requireWorkspace(Astro);
const r = await state.client
  .from("profiles")
  .select(
    "contact_number,country,status,email_verified_at,last_login_at,created_at,updated_at",
  )
  .eq("id", state.user.id)
  .single();
checked(r.error);
const photo = await profilePhoto(state).catch(() => null);
const name =
  [state.profile.first_name, state.profile.last_name]
    .filter(Boolean)
    .join(" ") || "Your account";
---

<AppLayout
  title="Profile information"
  active="account"
  state={state}
  description="Keep your personal contact details up to date."
>
  <a slot="actions" class="text-link" href="/account">Back to Account</a>
  <div class="profile-settings-grid">
    <aside class="stack">
      <section class="card profile-photo-card">
        <ProfileAvatar name={name} photo={Boolean(photo)} large />
        <h2>{name}</h2><p class="help-text">{state.profile.email}</p>
        <form class="form" data-file-form data-kind="profile">
          <input type="hidden" name="target_id" value="1" />
          <label class="field"
            >Profile photo<input
              type="file"
              accept="image/jpeg,image/png,image/webp"
              required
            /></label
          >
          <p class="help-text">JPEG, PNG or WebP, up to 5 MB.</p>
          <button class="button secondary" type="submit"
            >{photo ? "Change photo" : "Upload photo"}</button
          >
          <p data-form-message role="status" hidden></p>
        </form>
      </section>
    </aside>
    <section class="card profile-details-card">
      <p class="eyebrow">Personal details</p><h2>About you</h2><p
        class="help-text profile-form-intro"
      >
        Keep your contact details current.
      </p>
      {
        state.user.new_email && (
          <p class="form-message success" role="status">
            Email confirmation is pending for {state.user.new_email}. Your
            current email remains {state.user.email}.
          </p>
        )
      }
      <AccountForm action="profile">
        <div class="form-grid">
          <label class="field"
            >First name<input
              name="first_name"
              value={state.profile.first_name}
              required
              maxlength={fieldMaximum(80, state.profile.first_name)}
              autocomplete="given-name"
            /></label
          ><label class="field"
            >Last name<input
              name="last_name"
              value={state.profile.last_name}
              required
              maxlength={fieldMaximum(80, state.profile.last_name)}
              autocomplete="family-name"
            /></label
          >
        </div>
        <label class="field"
          >Email<input
            type="email"
            name="email"
            value={state.user.new_email ?? state.user.email}
            required
            maxlength="254"
            autocomplete="email"
          /></label
        >
        <p class="help-text">
          Email changes require confirmation. Open the links in the browser
          where you requested the change.
        </p>
        <label class="field"
          >Contact number<input
            type="tel"
            name="contact_number"
            value={r.data?.contact_number}
            maxlength={fieldMaximum(60, r.data?.contact_number)}
            autocomplete="tel"
          /></label
        >
        <label class="field"
          >Country<input
            name="country"
            value={r.data?.country}
            maxlength={fieldMaximum(100, r.data?.country)}
            autocomplete="country-name"
          /></label
        >
      </AccountForm>
    </section><section class="card profile-metadata-card">
      <details>
        <summary>Account information</summary>
        <dl class="mt-3">
          {
            [
              ["Status", r.data?.status],
              ["Email verified", r.data?.email_verified_at],
              ["Last login", r.data?.last_login_at],
              ["Created", r.data?.created_at],
              ["Updated", r.data?.updated_at],
            ].map(([label, value]) => (
              <div class="info-row">
                <>
                  <dt>{label}</dt>
                  <dd>
                    {label === "Status"
                      ? statusLabel(value)
                      : value
                        ? new Date(value).toLocaleString("en-CA", {
                            timeZone: "America/Edmonton",
                            timeZoneName: "short",
                          })
                        : "Not available"}
                  </dd>
                </>
              </div>
            ))
          }
        </dl>
      </details>
    </section>
  </div>
</AppLayout>

<script>
  import { bindProcurementForms } from "../../scripts/procurement";
  bindProcurementForms();
</script>
