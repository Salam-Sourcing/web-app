---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { teamCompany } from "../../../lib/server/account";
import { checked } from "../../../lib/server/catalog";
import { AccessError } from "../../../lib/security";
import { uuid, object, scopes } from "../../../lib/account";
const state = await requireWorkspace(Astro),
  c = teamCompany(state),
  id = uuid(Astro.params.id);
if (c.role !== "owner")
  throw new AccessError(
    403,
    "owner_required",
    "Only the owner can manage permission restrictions.",
  );
const r = await state.client.rpc("get_member_permissions", {
  p_company_id: c.id,
  p_user_id: id,
});
checked(r.error);
const override = object(r.data).override as string[] | null;
---

<AppLayout
  title="Permission restrictions"
  active="account"
  state={state}
  description="Restrictions can remove permissions from a role. They cannot grant permissions above that role."
>
  <a slot="actions" class="text-link" href="/account/team">Back to Team</a>
  <section class="card reading">
    <AccountForm action="permissions" company={c.id}>
      <input type="hidden" name="user_id" value={id} />
      <label class="field"
        >Permission mode<select name="mode"
          ><option value="role" selected={override === null}
            >Use role defaults</option
          ><option value="custom" selected={override !== null}
            >Custom restrictions</option
          ></select
        ></label
      >
      <fieldset>
        <legend>Allowed scopes within the member’s role</legend>{
          scopes.map((scope) => (
            <label class="check-row">
              <input
                type="checkbox"
                name={scope}
                checked={override?.includes(scope) ?? false}
              />
              {scope}
            </label>
          ))
        }
      </fieldset>
      <p class="help-text">
        Custom restrictions with no scopes selected remove all management
        permissions. Role defaults remove the custom override.
      </p>
    </AccountForm>
  </section>
</AppLayout>
