---
import AppLayout from "../../layouts/AppLayout.astro";
import AccountForm from "../../components/AccountForm.astro";
import NotificationCard from "../../components/NotificationCard.astro";
import Icon from "../../components/Icon.astro";
import { requireWorkspace } from "../../lib/server/access";
import { checked } from "../../lib/server/catalog";
import { notificationFeed } from "../../lib/server/notification-feed";
const state = await requireWorkspace(Astro);
const [items, count] = await Promise.all([
  notificationFeed(state),
  state.client
    .from("notifications")
    .select("id", { count: "exact", head: true })
    .eq("user_id", state.user.id)
    .eq("is_read", false),
]);
checked(count.error);
---

<AppLayout
  title="Notifications"
  active="account"
  state={state}
  description="Messages and updates from your business connections."
>
  <a
    slot="actions"
    class="button secondary notification-preferences"
    href="/account/preferences"><Icon name="settings" />Preferences</a
  >
  <section class="notification-center">
    <div class="notification-toolbar">
      <div>
        <strong data-notification-summary>{count.count ?? 0} unread</strong
        ><span class="help-text">Latest 100 updates</span>
      </div>
      <div class="notification-tools">
        <button
          class="icon-button"
          data-notification-refresh
          type="button"
          aria-label="Refresh notifications"
          title="Refresh notifications"><Icon name="refresh" /></button
        >
        <AccountForm
          class="notification-action"
          action="notifications-read"
          submit="Mark all read"
        />
      </div>
    </div>
    <p data-notification-feedback class="help-text" role="status" hidden></p>
    <button
      data-notification-updates
      class="button secondary notification-update-banner"
      type="button"
      hidden>Show latest updates</button
    >
    <div
      class="notification-list"
      data-notification-list
      data-notification-revision={JSON.stringify(items)}
    >
      {items.map((n) => <NotificationCard notice={n} />)}
      {
        !items.length && (
          <section class="notification-empty" data-notification-empty>
            <>
              <span class="notification-symbol">
                <Icon name="bell" size={28} />
              </span>
              <h2>You’re all caught up</h2>
              <p>New messages and marketplace updates will appear here.</p>
            </>
          </section>
        )
      }
    </div>
  </section>
</AppLayout>
