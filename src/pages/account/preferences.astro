---
import AppLayout from "../../layouts/AppLayout.astro";
import WebPushSettings from "../../components/WebPushSettings.astro";
import AccountForm from "../../components/AccountForm.astro";
import { requireWorkspace } from "../../lib/server/access";
import { notificationPreferences } from "../../lib/server/account";
import { preferences } from "../../lib/account";
const state = await requireWorkspace(Astro),
  data = await notificationPreferences(state);
const labels = {
  search_alerts: "Saved search alerts",
  messages: "Messages",
  enquiries: "Enquiries",
  quotes: "Quotes",
  deals: "Deals",
  listing_reviews: "Listing reviews",
};
---

<AppLayout
  title="Notification preferences"
  active="account"
  state={state}
  description="These settings are shared with the Salam Sourcing app."
>
  <a slot="actions" class="text-link" href="/account/notifications"
    >Notifications</a
  >
  <section class="card reading">
    <AccountForm action="preferences"
      ><fieldset>
        <legend>Marketplace updates</legend>{
          preferences.map((key) => (
            <label class="check-row">
              <input type="checkbox" name={key} checked={data[key]} />
              {labels[key]}
            </label>
          ))
        }
      </fieldset><p class="help-text">
        Saved search alerts also need to be enabled for each search. These
        preferences are separate from your browser’s notification permission.
      </p></AccountForm
    >
  </section>
  <WebPushSettings /></AppLayout
>
