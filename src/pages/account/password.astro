---
import Icon from "../../components/Icon.astro";
import TwoFactorSettings from "../../components/TwoFactorSettings.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout
  title="Security & password"
  description="Manage your password and two-factor authentication in one place."
  active="account"
  state={state}
>
  <a slot="actions" class="text-link" href="/account">Back to Account</a>
  <div class="security-settings">
    <section class="card security-section">
      <div class="security-section-heading">
        <span class="security-emblem"><Icon name="lock" size={25} /></span><div>
          <p class="eyebrow">Keep your sign-in personal</p><h2>
            Change your password
          </h2>
        </div>
      </div><p>
        Use at least eight characters. If a verification code is requested, send
        one to your email and enter it below.
      </p>
      <div class="security-tip">
        <Icon name="shield" size={18} /><p>
          Choose a long, unique passphrase—aim for 16 characters or more. A
          password manager can help you create and keep it. Avoid reusing your
          email password.
        </p>
      </div>
      <form
        class="form"
        data-api-form
        data-password-form
        method="post"
        action="/api/auth/password"
      >
        <label class="field"
          >New password<input
            data-password-field
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
          /></label
        ><label class="field"
          >Confirm new password<input
            data-password-field
            name="confirm_password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            maxlength="128"
            required
          /></label
        >
        <button class="password-reveal" type="button" data-password-code-request
          >Use an email verification code</button
        >
        <div data-password-verification hidden>
          <label class="field"
            >Email verification code<input
              name="nonce"
              autocomplete="one-time-code"
              inputmode="numeric"
              maxlength="128"
              disabled
            /></label
          >
        </div>
        <p class="form-message" data-form-message role="status" hidden>
        </p><button class="button" type="submit">Update password</button>
      </form>
      <form
        class="form"
        data-api-form
        method="post"
        action="/api/auth/reauthenticate"
        data-password-verification
        hidden
      >
        <p class="form-message" data-form-message role="status" hidden>
        </p><button class="button secondary" type="submit"
          >Send verification code</button
        >
      </form>
    </section>
    <TwoFactorSettings state={state} />
  </div>
</AppLayout>
<script>
  import { bindPasswordSettings } from "../../scripts/password-settings";
  bindPasswordSettings();
</script>
