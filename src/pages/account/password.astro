---
import Icon from "../../components/Icon.astro";
import PasswordChangeForm from "../../components/PasswordChangeForm.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout
  title="Change password"
  description="Update your password and verify your identity when needed."
  active="account"
  state={state}
>
  <a slot="actions" class="text-link" href="/account/security"
    >Back to Security & password</a
  >
  <div class="security-settings">
    <section class="card security-section">
      <div class="security-section-heading">
        <span class="security-emblem"><Icon name="lock" size={25} /></span><div>
          <p class="eyebrow">Keep your sign-in personal</p><h2>
            Change your password
          </h2>
        </div>
      </div><p>
        Enter your current password and choose a new one with at least eight
        characters. Some sessions also require an email verification code.
      </p>
      <div class="security-tip">
        <Icon name="shield" size={18} /><p>
          Choose a long, unique passphrase—aim for 16 characters or more. A
          password manager can help you create and keep it. Avoid reusing your
          email password.
        </p>
      </div>
      <PasswordChangeForm />
    </section>
  </div>
</AppLayout>
<script>
  import { bindPasswordSettings } from "../../scripts/password-settings";
  bindPasswordSettings();
</script>
