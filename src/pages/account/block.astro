---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
import { positiveId } from "../../lib/security";
const state = await requireWorkspace(Astro);
let target: number | undefined;
try {
  target = positiveId(Astro.url.searchParams.get("company"));
} catch {}
const summary = target
  ? await state.client.rpc("get_company_summaries", { p_company_ids: [target] })
  : null;
const company = summary?.data?.[0];
const allowed =
  company &&
  state.company?.id === state.safetyCompany?.id &&
  target !== state.safetyCompany?.id;
---

<AppLayout title="Block company" active="account" state={state}
  ><section class="card reading">
    {
      allowed ? (
        <>
          <>
            <h2>Block {company.display_name}?</h2>
            <p>
              This hides their listings and prevents contact with{" "}
              {state.safetyCompany?.display_name}.
            </p>
            <form
              class="form"
              data-api-form
              method="post"
              action="/api/safety/block"
            >
              <>
                <input type="hidden" name="target_id" value={target} />
                <input
                  type="hidden"
                  name="company_id"
                  value={state.safetyCompany?.id}
                />
                <label class="help-text">
                  <input
                    type="checkbox"
                    name="confirm"
                    value="CONFIRM"
                    required
                  />{" "}
                  Confirm company blocking.
                </label>
                <p
                  class="form-message"
                  data-form-message
                  role="status"
                  hidden
                />
                <button class="button danger" type="submit">
                  Block company
                </button>
              </>
            </form>
          </>
        </>
      ) : (
        <>
          <>
            <h2>Company blocking is unavailable here.</h2>
            <p>
              Open the company profile and use your default company,{" "}
              {state.safetyCompany?.display_name ?? "when available"}, to manage
              blocking.
            </p>
          </>
        </>
      )
    }<div class="actions">
      <a class="text-link" href="/account/safety">Back to safety</a>
    </div>
  </section></AppLayout
>
