---
import AppLayout from "../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../lib/server/access";
const state = await requireWorkspace(Astro);
const [blocked, deletion] = await Promise.all([
  state.client.rpc("list_blocked_companies"),
  state.client
    .from("account_deletion_requests")
    .select("requested_at,scheduled_for,status")
    .eq("user_id", state.user.id)
    .in("status", ["pending", "processing", "failed"])
    .maybeSingle(),
]);
const scoped = state.company?.id === state.safetyCompany?.id;
const date = (value: string) =>
  new Date(value).toLocaleDateString("en", {
    year: "numeric",
    month: "long",
    day: "numeric",
    timeZone: "UTC",
  });
---

<AppLayout title="Privacy & safety" active="account" state={state}
  ><div class="stack reading">
    <section class="card">
      <h2>Blocked companies</h2>{
        state.safetyCompany && (
          <p>
            Company safety for{" "}
            <strong>{state.safetyCompany.display_name}</strong>.
          </p>
        )
      }
      {
        !scoped && (
          <p class="form-message">
            Select {state.safetyCompany?.display_name ?? "your default company"}{" "}
            to manage blocking for this account.
          </p>
        )
      }
      {
        blocked.error ? (
          <p class="form-message">
            Unable to load blocked companies.{" "}
            <a class="text-link" href="/account/safety">
              Retry
            </a>
          </p>
        ) : blocked.data?.length ? (
          <ul class="settings-list">
            {blocked.data.map((company) => (
              <li class="py-4">
                <h3>{company.display_name}</h3>
                <p class="help-text">Blocked {date(company.blocked_at)}</p>
                {scoped && (
                  <form
                    class="form"
                    data-api-form
                    method="post"
                    action="/api/safety/unblock"
                  >
                    <input
                      type="hidden"
                      name="target_id"
                      value={company.company_id}
                    />
                    <input
                      type="hidden"
                      name="company_id"
                      value={state.safetyCompany?.id}
                    />
                    <label class="help-text">
                      <input
                        type="checkbox"
                        name="confirm"
                        value="CONFIRM"
                        required
                      />{" "}
                      Allow contact with this company again.
                    </label>
                    <p
                      class="form-message"
                      data-form-message
                      role="status"
                      hidden
                    />
                    <button class="button secondary" type="submit">
                      Unblock
                    </button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4">No blocked companies.</p>
        )
      }
      <p class="help-text mt-5">
        Blocking hides a company's listings and prevents further contact. Use
        the company's profile to report or block it.
      </p>
    </section>
    <section class="card">
      <h2>Delete account</h2><p>
        Deletion is scheduled with a 30-day recovery period. You can cancel
        while the request is pending. Some legally required transaction,
        billing, audit and moderation records may be retained or anonymized.
      </p>
      {
        deletion.error ? (
          <p class="form-message">
            Unable to verify deletion status.{" "}
            <a class="text-link" href="/account/safety">
              Retry
            </a>
          </p>
        ) : deletion.data ? (
          <>
            <p class="form-message mt-5">
              {deletion.data.status === "pending"
                ? "Scheduled for " + date(deletion.data.scheduled_for) + "."
                : deletion.data.status === "processing"
                  ? "Deletion is being processed and can no longer be cancelled."
                  : "Deletion needs an automatic retry and can no longer be cancelled."}
            </p>
            {deletion.data.status === "pending" && (
              <form
                class="form"
                data-api-form
                method="post"
                action="/api/safety/cancel-deletion"
              >
                <p
                  class="form-message"
                  data-form-message
                  role="status"
                  hidden
                />
                <button class="button secondary" type="submit">
                  Cancel account deletion
                </button>
              </form>
            )}
          </>
        ) : (
          <form
            class="form"
            data-api-form
            method="post"
            action="/api/safety/delete"
          >
            <>
              <label class="field">
                Type DELETE to confirm
                <input
                  name="confirm"
                  pattern="DELETE"
                  autocomplete="off"
                  required
                />
              </label>
              <p class="form-message" data-form-message role="status" hidden />
              <button class="button danger" type="submit">
                Schedule account deletion
              </button>
            </>
          </form>
        )
      }
    </section><section class="card">
      <h2>Policies and support</h2><div class="actions">
        <a class="text-link" href="/terms">Terms of Service</a><a
          class="text-link"
          href="/privacy">Privacy Policy</a
        ><a class="text-link" href="/help">Help Center</a>
      </div>
    </section>
  </div></AppLayout
>
