---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { positiveId } from "../../../lib/security";
import { checked } from "../../../lib/server/catalog";
import { object, rows } from "../../../lib/account";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
const result = await state.client.rpc("get_saved_search_matches", {
  p_search_id: id,
});
checked(result.error);
const data = object(result.data),
  search = object(data.search),
  matches = rows(data.matches),
  f = object(search.filters);
---

<AppLayout
  title={search.name}
  active="account"
  state={state}
  description="Current matching results, newest first. Up to 50 matches are shown."
>
  <a slot="actions" class="text-link" href="/account/searches"
    >All saved searches</a
  >
  <section class="card reading">
    <AccountForm action="search-save" id={id}
      ><input type="hidden" name="kind" value={search.kind} /><input
        type="hidden"
        name="filters"
        value={JSON.stringify(f)}
      /><label class="field"
        >Name<input
          name="name"
          value={search.name}
          required
          maxlength="80"
        /></label
      ><label class="field"
        >Search phrase<input
          name="query"
          value={f.query ?? ""}
          maxlength="200"
        /></label
      ><label class="field"
        >Category<input
          name="category"
          value={f.category ?? ""}
          maxlength="200"
        /></label
      ><label class="field"
        >Location<input
          name="location"
          value={f.location ?? ""}
          maxlength="200"
        /></label
      ><div class="form-grid">
        {
          [
            ["min_price", "Minimum price"],
            ["max_price", "Maximum price"],
            ["max_moq", "Maximum order quantity"],
            ["max_lead_days", "Maximum lead days"],
          ].map(([key, label]) => (
            <label class="field">
              {label}
              <input
                name={key}
                type="number"
                value={f[key] ?? ""}
                min="0"
                max="1000000000000"
                step={key === "max_lead_days" ? "1" : "any"}
              />
            </label>
          ))
        }
      </div><label class="field"
        >Currency<input
          name="currency"
          value={f.currency ?? ""}
          pattern="[A-Z]{3}"
          maxlength="3"
        /></label
      ><label class="check-row"
        ><input
          name="verified"
          type="checkbox"
          checked={f.verified === true}
        />Verified suppliers only</label
      ><label class="check-row"
        ><input name="alerts" type="checkbox" checked={search.alerts} />Enable
        matching alerts</label
      ><label class="field"
        >Frequency<select name="frequency"
          ><option value="daily" selected={search.frequency === "daily"}
            >Daily</option
          ><option value="hourly" selected={search.frequency === "hourly"}
            >Hourly</option
          ></select
        ></label
      ><p class="help-text">
        Matching alerts also require Saved search alerts in your notification
        preferences.
      </p></AccountForm
    >
  </section>
  <section class="card mt-5">
    <h2>Matches</h2><ul class="settings-list">
      {
        matches.map((m) => (
          <li>
            <a
              class="settings-link"
              href={
                (search.kind === "rfq" ? "/enquiries/" : "/listings/") +
                m.id
              }
            >
              <strong>{m.title}</strong>
            </a>
          </li>
        ))
      }
    </ul>{!matches.length && <p>No current matches.</p>}
  </section>
  <script>
    import { bindSearchForms } from "../../../scripts/account";
    bindSearchForms();
  </script>
</AppLayout>
