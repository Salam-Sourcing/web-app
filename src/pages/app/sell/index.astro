---
import AppLayout from "../../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { checked } from "../../../lib/server/catalog";
import { listingStatuses, PAGE_SIZE, searchInput } from "../../../lib/catalog";
const state = await requireWorkspace(Astro),
  company = state.company,
  canList = state.permissions.includes("listings");
const offset = searchInput(Astro.url.searchParams).offset;
const chosen = Astro.url.searchParams.get("status") ?? "all";
const status = listingStatuses.includes(
  chosen as (typeof listingStatuses)[number],
)
  ? chosen
  : "all";
let rows: {
  id: number;
  name: string;
  status: string;
  updated_at: string;
  listing_images: { id: number }[];
}[] = [];
let count = 0,
  error: string | null = null,
  counts: Record<string, number> = {};
if (company && canList) {
  try {
    const results = await Promise.all(
      listingStatuses.map(async (value) => {
        const result = await state.client
          .from("listings")
          .select("id", { count: "exact", head: true })
          .eq("company_id", company.id)
          .eq("status", value);
        checked(result.error);
        return [value, result.count ?? 0] as const;
      }),
    );
    counts = Object.fromEntries(results);
    let query = state.client
      .from("listings")
      .select("id,name,status,updated_at,listing_images(id)", {
        count: "exact",
      })
      .eq("company_id", company.id);
    if (status !== "all") query = query.eq("status", status);
    const result = await query
      .order("updated_at", { ascending: false })
      .order("id", { ascending: false })
      .range(offset, offset + PAGE_SIZE - 1);
    checked(result.error);
    rows = result.data ?? [];
    count = result.count ?? 0;
  } catch (e) {
    error = e instanceof Error ? e.message : "Unable to load your listings.";
  }
}
---

<AppLayout title="Sell" active="sell" state={state}>
  {
    !company ? (
      <section class="card empty-state">
        <>
          <h2>Start with your company</h2>
          <p>Create a company profile to build your catalog.</p>
          <a class="button mt-5" href="/app/company/new">
            Create company
          </a>
        </>
      </section>
    ) : (
      <>
        <section class="card catalog-intro">
          <>
            <div>
              <>
                <p class="eyebrow">Your seller workspace</p>
                <h2>{company.display_name}</h2>
                <p class="help-text">
                  {[company.city, company.province_state, company.country]
                    .filter(Boolean)
                    .join(", ")}
                </p>
                <span class="badge mt-3">{company.verification_status}</span>
              </>
            </div>
            <div class="actions">
              {canList && (
                <a class="button" href="/app/sell/new">
                  Post an item
                </a>
              )}
              <a class="button secondary" href="/app/company">
                Company profile & verification
              </a>
              {state.permissions.includes("insights") && (
                <a class="text-link" href="/app/account/insights">
                  Supplier insights
                </a>
              )}
            </div>
          </>
        </section>
        {!canList ? (
          <section class="card mt-6">
            <h2>Listing access is restricted</h2>
            <p>
              Your effective company permissions do not include listing
              management. Contact your company administrator.
            </p>
          </section>
        ) : (
          <>
            {company.verification_status !== "verified" && (
              <p class="form-message mt-6">
                You can save drafts. Verify your company before submitting
                listings for moderation.
              </p>
            )}
            {!error && (
              <nav class="tab-row mt-6" aria-label="Listing status">
                <a
                  href="/app/sell"
                  aria-current={status === "all" ? "page" : undefined}
                >
                  All ({Object.values(counts).reduce((a, b) => a + b, 0)})
                </a>
                {listingStatuses.map((value) => (
                  <a
                    href={"/app/sell?status=" + value}
                    aria-current={status === value ? "page" : undefined}
                  >
                    {value.replaceAll("_", " ")} ({counts[value] ?? 0})
                  </a>
                ))}
              </nav>
            )}
            {error ? (
              <section class="card">
                <p class="form-message" role="alert">
                  {error}
                </p>
                <a
                  class="button secondary"
                  href={Astro.url.pathname + Astro.url.search}
                >
                  Retry
                </a>
              </section>
            ) : rows.length === 0 ? (
              <section class="card empty-state">
                <h2>
                  {status === "all"
                    ? "No listings yet"
                    : "No " + status.replaceAll("_", " ") + " listings"}
                </h2>
                <p>
                  Start with a manual draft. Only approved listings appear in
                  discovery.
                </p>
                <a class="button mt-5" href="/app/sell/new">
                  Create listing
                </a>
              </section>
            ) : (
              <div class="seller-list">
                {rows.map((row) => (
                  <article class="card seller-row">
                    <a class="seller-thumbnail" href={"/app/sell/" + row.id}>
                      {row.listing_images.length > 0 ? (
                        <img
                          data-private-media
                          src={"/api/media/listing/" + row.id}
                          alt=""
                          loading="lazy"
                        />
                      ) : (
                        <span aria-hidden="true">▧</span>
                      )}
                    </a>
                    <div>
                      <h2>
                        <a href={"/app/sell/" + row.id}>{row.name}</a>
                      </h2>
                      <p class="help-text">
                        Updated{" "}
                        {new Date(row.updated_at).toLocaleDateString("en", {
                          timeZone: "UTC",
                        })}
                      </p>
                    </div>
                    <span class="badge">{row.status.replaceAll("_", " ")}</span>
                    <a class="text-link" href={"/app/sell/" + row.id}>
                      Manage
                    </a>
                  </article>
                ))}
              </div>
            )}
            <div class="actions justify-center">
              {offset > 0 && (
                <a
                  class="button secondary"
                  href={
                    "?status=" +
                    status +
                    "&offset=" +
                    Math.max(0, offset - PAGE_SIZE)
                  }
                >
                  Previous
                </a>
              )}
              {offset + PAGE_SIZE < count && (
                <a
                  class="button secondary"
                  href={"?status=" + status + "&offset=" + (offset + PAGE_SIZE)}
                >
                  Next listings
                </a>
              )}
            </div>
          </>
        )}
      </>
    )
  }
</AppLayout>
