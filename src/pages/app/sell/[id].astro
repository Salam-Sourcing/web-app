---
import AppLayout from "../../../layouts/AppLayout.astro";
import ListingForm from "../../../components/ListingForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { sellerListing, taxonomy, checked } from "../../../lib/server/catalog";
import { positiveId } from "../../../lib/security";
import { allowedTransition } from "../../../lib/catalog";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id),
  listing = await sellerListing(state, id);
const categories = await taxonomy(state);
const review = await state.client
  .from("listing_verifications")
  .select("rejection_reason")
  .eq("listing_id", id)
  .eq("status", "rejected")
  .order("reviewed_at", { ascending: false })
  .limit(1)
  .maybeSingle();
checked(review.error);
const editable = !["pending_review", "archived"].includes(listing.status);
const images = [...listing.listing_images].sort(
  (a, b) =>
    Number(b.is_primary) - Number(a.is_primary) ||
    a.display_order - b.display_order,
);
const labels: Record<string, string> = {
  submit: "Submit for review",
  pause: "Pause listing",
  resume: "Resume listing",
  archive: "Archive listing",
};
---

<AppLayout title="Manage listing" active="sell" state={state}
  ><div class="stack reading">
    <section class="card">
      <a class="text-link" href="/app/sell">← Your listings</a><h2 class="mt-5">
        {listing.name}
      </h2><span class="badge mt-3">{listing.status.replaceAll("_", " ")}</span>
      {
        ["draft", "pending_review"].includes(listing.status) &&
          Astro.url.searchParams.get("saved") && (
            <p class="form-message success mt-4">
              {listing.status === "pending_review"
                ? "Submitted for moderation. Your listing is not public until approved."
                : "Your draft was saved."}
            </p>
          )
      }
      {
        review.data?.rejection_reason && (
          <p class="form-message mt-4">
            Review: {review.data.rejection_reason}
          </p>
        )
      }
      {
        images.length > 0 && (
          <div class="upload-previews mt-5">
            {images.map((image) => (
              <img
                data-private-media
                src={"/api/media/listing/" + id + "?image=" + image.id}
                alt={image.is_primary ? "Cover image" : "Listing image"}
              />
            ))}
          </div>
        )
      }
      <p class="help-text mt-5">
        Images are retained in their existing cover/display order. Editing a
        published or paused listing returns it to draft and requires a new
        review.
      </p>
      {
        listing.status === "published" && (
          <a class="text-link mt-4" href={"/app/listings/" + id}>
            View marketplace listing
          </a>
        )
      }
      <div class="listing-transitions">
        {
          ["submit", "pause", "resume", "archive"]
            .filter((action) => allowedTransition(listing.status, action))
            .map((action) => (
              <form
                class="form"
                data-api-form
                method="post"
                action="/api/catalog/listing-status"
              >
                <>
                  <input
                    type="hidden"
                    name="company_id"
                    value={listing.company_id}
                  />
                  <input type="hidden" name="listing_id" value={id} />
                  <input type="hidden" name="transition" value={action} />
                  <label class="checkbox-field">
                    <input
                      type="checkbox"
                      name="confirm"
                      value="CONFIRM"
                      required
                    />{" "}
                    Confirm {action === "submit" ? "submission" : action}
                  </label>
                  <p
                    class="form-message"
                    data-form-message
                    role="status"
                    hidden
                  />
                  <button
                    class:list={[
                      "button",
                      action === "archive" ? "danger" : "secondary",
                    ]}
                    type="submit"
                    disabled={
                      action === "submit" &&
                      state.company?.verification_status !== "verified"
                    }
                  >
                    {labels[action]}
                  </button>
                </>
              </form>
            ))
        }
      </div>
    </section>
    {
      editable ? (
        <section class="card">
          <>
            <h2>Edit listing</h2>
            <ListingForm
              companyId={listing.company_id}
              categories={categories}
              listing={listing}
            />
          </>
        </section>
      ) : (
        <section class="card">
          <>
            <h2>
              {listing.status === "pending_review"
                ? "Under review"
                : "Archived"}
            </h2>
            <p>
              {listing.status === "pending_review"
                ? "Editing is unavailable while this listing is being reviewed."
                : "Archived listings cannot be edited or resumed."}
            </p>
          </>
        </section>
      )
    }
  </div></AppLayout
>
