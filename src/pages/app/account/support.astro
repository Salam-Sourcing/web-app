---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { checked } from "../../../lib/server/catalog";
import { object, rows } from "../../../lib/account";
const state = await requireWorkspace(Astro);
const [list, subjects] = await Promise.all([
  state.client.rpc("customer_support", { p_action: "list" }),
  state.client.rpc("customer_support", { p_action: "subjects" }),
]);
checked(list.error);
checked(subjects.error);
const requests = rows(list.data),
  eligible = object(subjects.data),
  submissions = rows(eligible.submissions),
  companies = rows(eligible.companies);
const transfers: { company: number; label: string; user: string }[] = [];
for (const company of companies) {
  const r = await state.client.rpc("get_company_team", {
    p_company_id: company.id,
  });
  if (r.error) continue;
  for (const member of rows(object(r.data).members))
    if (member.user_id !== state.user.id && member.role !== "owner")
      transfers.push({
        company: company.id,
        label: company.name + " · " + (member.name || member.email),
        user: member.user_id,
      });
}
---

<AppLayout
  title="Support requests"
  active="account"
  state={state}
  description="Reply to support, appeal rejected submissions or request an ownership transfer."
>
  <a slot="actions" class="text-link" href="/help">Help Center</a>
  <div class="account-grid">
    <section class="card">
      <h2>Appeal a submission</h2>{
        submissions.length ? (
          <AccountForm
            action="support-appeal"
            submit="Submit appeal"
            uncertain
            check="/app/account/support"
          >
            <>
              <label class="field">
                Rejected submission
                <select name="subject">
                  {submissions.map((s) => (
                    <option value={s.entity_type + ":" + s.id}>
                      {s.name} · {s.entity_type}
                    </option>
                  ))}
                </select>
              </label>
              <input type="hidden" name="entity_type" />
              <input type="hidden" name="entity_id" />
              <label class="field">
                Reason
                <textarea
                  name="reason"
                  required
                  minlength="10"
                  maxlength="10000"
                  rows="5"
                />
              </label>
            </>
          </AccountForm>
        ) : (
          <p>No rejected submissions are eligible for appeal.</p>
        )
      }
    </section>
    <section class="card">
      <h2>Ownership transfer</h2>{
        transfers.length ? (
          <AccountForm
            action="support-recovery"
            submit="Request ownership transfer"
            uncertain
            check="/app/account/support"
          >
            <>
              <>
                <label class="field">
                  Company &amp; proposed owner
                  <select name="transfer_subject" required>
                    {transfers.map((t) => (
                      <option value={t.company + ":" + t.user}>
                        {t.label}
                      </option>
                    ))}
                  </select>
                </label>
                <input type="hidden" name="entity_id" />
                <input type="hidden" name="proposed_owner" />
              </>
              <label class="field">
                Reason
                <textarea
                  name="reason"
                  required
                  minlength="10"
                  maxlength="10000"
                  rows="5"
                />
              </label>
              <p class="help-text">
                This starts a support review. Ownership remains unchanged until
                the request is approved.
              </p>
            </>
          </AccountForm>
        ) : (
          <p>
            No eligible members are available for ownership transfer. Check your
            company’s team access before requesting a transfer.
          </p>
        )
      }
    </section>
  </div>
  <section class="card mt-5">
    <h2>Your requests</h2><div class="stack">
      {
        requests.map((r) => (
          <article class="account-item">
            <>
              <>
                <h3>
                  {r.kind} · {r.status}
                </h3>
                <p class="account-copy">{r.prompt}</p>
                {r.reply && <p class="account-copy">Your reply: {r.reply}</p>}
                {["waiting", "replied"].includes(r.status) && (
                  <AccountForm
                    action="support-reply"
                    id={r.id}
                    submit="Send reply"
                  >
                    <input type="hidden" name="version" value={r.version} />
                    <label class="field">
                      Reply
                      <textarea
                        name="reply"
                        required
                        maxlength="10000"
                        rows="4"
                      />
                    </label>
                  </AccountForm>
                )}
              </>
            </>
          </article>
        ))
      }
    </div>{!requests.length && <p>No support requests yet.</p>}
  </section>
  <section class="card reading mt-5">
    <h2>Download your account data</h2><p class="help-text">
      Exports your personal records as a private JSON file. Company records
      authored by other members are not included. Large exports can be requested
      through support.
    </p><form class="form" data-export-form>
      <p class="form-message" data-form-message hidden role="status"></p><button
        class="button secondary"
        type="submit">Download personal data</button
      >
    </form>
  </section>
  <script>
    import { bindAccountTools } from "../../../scripts/account";
    bindAccountTools();
  </script>
</AppLayout>
