---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { checked } from "../../../lib/server/catalog";
const state = await requireWorkspace(Astro);
const r = await state.client
  .from("profiles")
  .select("contact_number,country")
  .eq("id", state.user.id)
  .single();
checked(r.error);
---

<AppLayout
  title="Profile information"
  active="account"
  state={state}
  description="Keep your personal contact details up to date."
>
  <a slot="actions" class="text-link" href="/app/account">Back to Account</a>
  <section class="card reading">
    {
      state.user.new_email && (
        <p class="form-message success" role="status">
          Email confirmation is pending for {state.user.new_email}. Your current
          email remains {state.user.email}.
        </p>
      )
    }
    <AccountForm action="profile">
      <div class="form-grid">
        <label class="field"
          >First name<input
            name="first_name"
            value={state.profile.first_name}
            required
            maxlength="80"
            autocomplete="given-name"
          /></label
        ><label class="field"
          >Last name<input
            name="last_name"
            value={state.profile.last_name}
            required
            maxlength="80"
            autocomplete="family-name"
          /></label
        >
      </div>
      <label class="field"
        >Email<input
          type="email"
          name="email"
          value={state.user.new_email ?? state.user.email}
          required
          maxlength="254"
          autocomplete="email"
        /></label
      >
      <p class="help-text">
        Email changes require confirmation. Open the links in the browser where
        you requested the change.
      </p>
      <label class="field"
        >Contact number<input
          type="tel"
          name="contact_number"
          value={r.data?.contact_number}
          maxlength="60"
          autocomplete="tel"
        /></label
      >
      <label class="field"
        >Country<input
          name="country"
          value={r.data?.country}
          maxlength="100"
          autocomplete="country-name"
        /></label
      >
    </AccountForm>
  </section>
</AppLayout>
