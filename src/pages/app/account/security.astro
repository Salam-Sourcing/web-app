---
import AppLayout from "../../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout title="Account security" active="account" state={state}
  ><section class="card reading">
    <h2>Two-factor authentication</h2><p>
      Add another layer of protection with an authenticator app. A code will be
      required before you can access your private workspace.
    </p>
    {
      state.factors.length > 0 ? (
        <>
          <span class="badge success mt-5">Enabled</span>
          {state.factors.map((factor) => (
            <form
              class="form"
              data-api-form
              method="post"
              action="/api/auth/mfa-remove"
            >
              <input type="hidden" name="factor_id" value={factor.id} />
              <p class="help-text">
                Removing your authenticator reduces account protection. Type
                REMOVE to confirm.
              </p>
              <label class="field">
                Confirmation
                <input
                  name="confirm"
                  pattern="REMOVE"
                  autocomplete="off"
                  required
                />
              </label>
              <p class="form-message" data-form-message role="status" hidden />
              <button class="button danger" type="submit">
                Remove authenticator
              </button>
            </form>
          ))}
        </>
      ) : (
        <>
          <>
            <button class="button mt-6" id="enroll-authenticator" type="button">
              Set up authenticator
            </button>
            <p class="form-message" id="enroll-message" role="status" hidden />
          </>
          <section id="authenticator-setup" class="mt-6" hidden>
            <>
              <h3>Scan the QR code</h3>
              <img
                class="qr-image"
                id="authenticator-qr"
                alt="QR code for your authenticator app"
              />
              <p class="help-text">
                Or enter this setup key manually. Keep it private.
              </p>
              <p class="secret mt-3" id="authenticator-secret" />
            </>
            <form
              class="form"
              id="enrollment-verification"
              data-api-form
              method="post"
              action="/api/auth/mfa-verify"
            >
              <>
                <input type="hidden" name="factor_id" />
                <input type="hidden" name="purpose" value="enrollment" />
                <input
                  type="hidden"
                  name="next"
                  value="/app/account/security"
                />
                <label class="field">
                  Six-digit code
                  <input
                    name="code"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    pattern="[0-9]{6}"
                    maxlength="6"
                    minlength="6"
                    required
                  />
                </label>
                <p
                  class="form-message"
                  data-form-message
                  role="status"
                  hidden
                />
                <button class="button" type="submit">
                  Verify and enable
                </button>
              </>
            </form>
            <form
              class="form"
              id="enrollment-cancel"
              data-api-form
              method="post"
              action="/api/auth/mfa-cancel"
            >
              <>
                <input type="hidden" name="factor_id" />
                <p
                  class="form-message"
                  data-form-message
                  role="status"
                  hidden
                />
                <button class="button secondary" type="submit">
                  Cancel setup
                </button>
              </>
            </form>
          </section>
        </>
      )
    }
    <div class="actions">
      <a class="text-link" href="/app/account">Back to account</a>
    </div>
  </section></AppLayout
>
<script>
  import { post } from "../../../scripts/forms";
  const button = document.querySelector<HTMLButtonElement>(
    "#enroll-authenticator",
  );
  const message = document.querySelector<HTMLElement>("#enroll-message");
  let pendingFactor: string | undefined;
  button?.addEventListener("click", async () => {
    button.disabled = true;
    try {
      const result = await post("/api/auth/mfa-enroll", {});
      const factor = result as unknown as {
        id: string;
        totp: { qr_code: string; secret: string };
      };
      pendingFactor = factor.id;
      document.querySelector<HTMLImageElement>("#authenticator-qr")!.src =
        "data:image/svg+xml;base64," + btoa(factor.totp.qr_code);
      document.querySelector("#authenticator-secret")!.textContent =
        factor.totp.secret;
      document
        .querySelectorAll<HTMLInputElement>(
          "#authenticator-setup input[name=factor_id]",
        )
        .forEach((input) => (input.value = factor.id));
      document.querySelector<HTMLElement>("#authenticator-setup")!.hidden =
        false;
      button.hidden = true;
    } catch (error) {
      if (message) {
        message.hidden = false;
        message.textContent =
          error instanceof Error
            ? error.message
            : "Unable to set up your authenticator.";
      }
    } finally {
      button.disabled = false;
    }
  });
  window.addEventListener("pagehide", () => {
    if (pendingFactor)
      navigator.sendBeacon(
        "/api/auth/mfa-cancel",
        new Blob([JSON.stringify({ factor_id: pendingFactor })], {
          type: "application/json",
        }),
      );
  });
</script>
