---
import AppLayout from "../../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout title="Update password" active="account" state={state}
  ><section class="card reading">
    <h2>Choose a new password</h2><p>
      Use at least eight characters. If a verification code is requested, send
      one to your email and enter it below.
    </p>
    <form class="form" data-api-form method="post" action="/api/auth/password">
      <label class="field"
        >New password<input
          name="password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          maxlength="128"
          required
        /></label
      ><label class="field"
        >Confirm new password<input
          name="confirm_password"
          type="password"
          autocomplete="new-password"
          minlength="8"
          maxlength="128"
          required
        /></label
      ><label class="field"
        >Verification code, if requested<input
          name="nonce"
          autocomplete="one-time-code"
          maxlength="128"
        /></label
      ><p class="form-message" data-form-message role="status" hidden>
      </p><button class="button" type="submit">Update password</button>
    </form>
    <form
      class="form"
      data-api-form
      method="post"
      action="/api/auth/reauthenticate"
    >
      <p class="form-message" data-form-message role="status" hidden></p><button
        class="button secondary"
        type="submit">Send verification code</button
      >
    </form><div class="actions">
      <a class="text-link" href="/app/account">Back to account</a>
    </div>
  </section></AppLayout
>
