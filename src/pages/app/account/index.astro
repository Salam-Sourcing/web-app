---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import Icon from "../../../components/Icon.astro";
import { requireWorkspace } from "../../../lib/server/access";
const state = await requireWorkspace(Astro);
const companyItems = [
  ["team", "Company & team", "team"],
  ["billing", "Plans & billing", "billing"],
  ["insights", "Supplier insights", "insights"],
];
const items = [
  [
    "profile",
    "company",
    "Profile information",
    "Update your name, email and contact details.",
  ],
  [
    "notifications",
    "messages",
    "Notifications",
    "Read marketplace updates and manage preferences.",
  ],
  [
    "searches",
    "discover",
    "Saved searches",
    "Keep sourcing filters and opt into matching alerts.",
  ],
  [
    "support",
    "help",
    "Support & account data",
    "Replies, appeals, ownership requests and personal export.",
  ],
  [
    "security",
    "shield",
    "Two-factor authentication",
    "Protect your account with an authenticator app.",
  ],
  ["password", "shield", "Password", "Update your password or recover access."],
  [
    "safety",
    "company",
    "Privacy & safety",
    "Manage company blocking and account deletion.",
  ],
];
---

<AppLayout title="Account" active="account" state={state}
  ><div class="account-grid">
    <div class="stack">
      <section class="card">
        <p class="eyebrow">Your account</p><h2>
          {
            [state.profile.first_name, state.profile.last_name]
              .filter(Boolean)
              .join(" ")
          }
        </h2><p class="mt-2">{state.profile.email}</p><ul class="settings-list">
          {
            items.map(([path, icon, title, description]) => (
              <li>
                <a class="settings-link" href={"/app/account/" + path}>
                  <>
                    <Icon name={icon} />
                    <div>
                      <>
                        <strong>{title}</strong>
                        <span>{description}</span>
                      </>
                    </div>
                  </>
                </a>
              </li>
            ))
          }<li>
            <a class="settings-link" href="/help"
              ><Icon name="help" /><div>
                <strong>Help Center</strong><span
                  >Find answers or contact Salam Sourcing support.</span
                >
              </div></a
            >
          </li>
        </ul>
        <form
          class="form"
          data-api-form
          action="/api/auth/logout"
          method="post"
        >
          <p class="form-message" data-form-message role="status" hidden>
          </p><button class="button secondary" type="submit">Sign out</button>
        </form>
      </section>
    </div><section class="card">
      <p class="eyebrow">Company workspace</p>{
        state.company ? (
          <>
            <>
              <h2>{state.company.display_name}</h2>
              <dl>
                <>
                  <div class="info-row">
                    <>
                      <dt>Your role</dt>
                      <dd>{state.company.role}</dd>
                    </>
                  </div>
                  <div class="info-row">
                    <>
                      <dt>Location</dt>
                      <dd>
                        {[
                          state.company.city,
                          state.company.province_state,
                          state.company.country,
                        ]
                          .filter(Boolean)
                          .join(", ") || "Not provided"}
                      </dd>
                    </>
                  </div>
                </>
              </dl>
              <div class="actions mt-5">
                <>
                  <a class="button secondary" href="/app/deals">
                    Company deals
                  </a>
                  <a
                    class="text-link"
                    href={"/app/suppliers/" + state.company.id + "/reviews"}
                  >
                    Company reviews & responses
                  </a>
                </>
              </div>
              <h3 class="mt-5">Your permissions</h3>
              <div class="permission-list">
                {state.permissions.length ? (
                  state.permissions.map((permission) => (
                    <span class="badge">{permission}</span>
                  ))
                ) : (
                  <p class="help-text">
                    You have no management permissions for this company.
                  </p>
                )}
              </div>
            </>
          </>
        ) : (
          <>
            <>
              <h2>Your company comes next.</h2>
              <p>
                Create your company to begin sourcing. Existing app companies
                appear here when you use the same account.
              </p>
            </>
          </>
        )
      }<ul class="settings-list">
        {
          companyItems
            .filter(
              ([, , scope]) =>
                state.permissions.includes(scope) &&
                (scope !== "team" ||
                  ["owner", "admin"].includes(state.company?.role ?? "")),
            )
            .map(([path, title]) => (
              <li>
                <a class="settings-link" href={"/app/account/" + path}>
                  <strong>{title}</strong>
                </a>
              </li>
            ))
        }
      </ul>
      <div class="actions">
        <a
          class="button secondary"
          href={state.company ? "/app/company" : "/app/company/new"}
          >{
            state.company ? "Company profile & verification" : "Create company"
          }</a
        ><a class="text-link" href="/app/saved">Saved listings & suppliers</a>
      </div><hr class="divider" /><AccountForm
        action="invitation-preview"
        submit="Preview invitation"
        ><label class="field"
          >Company invitation code<input
            name="invitation_id"
            required
            maxlength="36"
          /></label
        ></AccountForm
      ><p class="help-text">
        Company membership, verification and account access are shared with your
        Salam Sourcing app.
      </p>
    </section>
  </div></AppLayout
>
