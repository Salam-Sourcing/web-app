---
import AppLayout from "../../../layouts/AppLayout.astro";
import AccountForm from "../../../components/AccountForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
import { team } from "../../../lib/server/account";
import { teamRoles } from "../../../lib/account";
const state = await requireWorkspace(Astro),
  data = await team(state),
  c = state.company!;
const allowedRoles = [...teamRoles]
  .reverse()
  .filter((role) => role !== "admin" || c.role === "owner");
---

<AppLayout
  title="Company & team"
  active="account"
  state={state}
  description={"Manage access to " + c.display_name + "."}
>
  <a slot="actions" class="text-link" href="/app/account">Back to Account</a>
  <div class="account-grid">
    <section class="card">
      <h2>Invite a member</h2><p class="help-text">
        Share the invitation link or code directly. Email delivery is currently
        disabled.
      </p>
      <AccountForm
        action="invite"
        company={c.id}
        submit="Create invitation"
        uncertain
        check="/app/account/team"
      >
        <label class="field"
          >Email<input
            name="email"
            type="email"
            required
            maxlength="254"
          /></label
        >
        <label class="field"
          >Role<select name="role"
            >{
              allowedRoles.map((role) => (
                <option value={role} selected={role === "member"}>
                  {role}
                </option>
              ))
            }</select
          ></label
        >
      </AccountForm>
    </section>
    <section class="card">
      <h2>Pending invitations</h2><div class="stack">
        {
          data.invitations.map((i) => (
            <article class="account-item">
              <>
                <>
                  <h3>{i.email}</h3>
                  <p>
                    {i.role} · expires{" "}
                    {new Date(i.expires_at).toLocaleDateString("en-CA")}
                  </p>
                  <label class="field">
                    Invitation link
                    <input
                      readonly
                      value={new URL("/invite/" + i.id, Astro.url.origin).href}
                    />
                  </label>
                  <label class="field">
                    Invitation code
                    <input readonly value={i.id} />
                  </label>
                  <AccountForm
                    action="revoke-invitation"
                    company={c.id}
                    submit="Revoke invitation"
                  >
                    <input type="hidden" name="invitation_id" value={i.id} />
                  </AccountForm>
                </>
              </>
            </article>
          ))
        }{!data.invitations.length && <p>No pending invitations.</p>}
      </div>
    </section>
  </div>
  <section class="card mt-5">
    <h2>Members</h2><div class="stack">
      {
        data.members.map((member) => (
          <article class="account-item">
            <>
              <div class="section-heading">
                <div>
                  <>
                    <h3>{member.name || member.email}</h3>
                    <p>
                      {member.email} · {member.role}
                    </p>
                  </>
                </div>
                {c.role === "owner" &&
                  member.user_id !== state.user.id &&
                  member.role !== "owner" && (
                    <a
                      class="text-link"
                      href={"/app/account/team/" + member.user_id}
                    >
                      Permission restrictions
                    </a>
                  )}
              </div>
              {member.user_id !== state.user.id &&
                member.role !== "owner" &&
                (c.role === "owner" || member.role !== "admin") && (
                  <AccountForm
                    action="member"
                    company={c.id}
                    submit="Apply member change"
                  >
                    <input
                      type="hidden"
                      name="user_id"
                      value={member.user_id}
                    />
                    <div class="form-grid">
                      <label class="field">
                        Role
                        <select name="role">
                          {allowedRoles.map((role) => (
                            <option
                              selected={role === member.role}
                              value={role}
                            >
                              {role}
                            </option>
                          ))}
                        </select>
                      </label>
                      <label class="field">
                        Action
                        <select name="operation">
                          <option value="role">Change role</option>
                          <option value="remove">Remove member</option>
                        </select>
                      </label>
                    </div>
                    <label class="check-row">
                      <input
                        type="checkbox"
                        name="confirm"
                        value="CONFIRM"
                        required
                      />
                      I confirm this change to the member’s access.
                    </label>
                  </AccountForm>
                )}
            </>
          </article>
        ))
      }
    </div>
  </section>
</AppLayout>
