---
import AppLayout from "../../../../layouts/AppLayout.astro";
import QuoteCard from "../../../../components/QuoteCard.astro";
import ProcurementAction from "../../../../components/ProcurementAction.astro";
import { requireWorkspace } from "../../../../lib/server/access";
import {
  quoteBundle,
  companySummaries,
  quoteTarget,
} from "../../../../lib/server/procurement";
import { checked } from "../../../../lib/server/catalog";
import { positiveId, AccessError } from "../../../../lib/security";
import { location, dateLabel, openEnquiry } from "../../../../lib/procurement";
import { quantityLabel } from "../../../../lib/procurement";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id),
  bundle = await quoteBundle(state, id),
  e = bundle.enquiry;
const owner =
  state.company?.id === e.buyer_company_id &&
  state.permissions.includes("procurement");
const [companies, attachments, invites, conversations, saved, deal] =
  await Promise.all([
    companySummaries(state, [e.buyer_company_id]),
    state.client
      .from("enquiry_attachments")
      .select("id,file_name,file_size_bytes,uploaded_by_user_id")
      .eq("enquiry_id", id)
      .order("created_at"),
    state.client
      .from("enquiry_supplier_invitations")
      .select("id,supplier_company_id,status")
      .eq("enquiry_id", id),
    state.client
      .from("conversations")
      .select("id,buyer_company_id,supplier_company_id")
      .eq("enquiry_id", id),
    state.client
      .from("saved_enquiries")
      .select("id")
      .eq("enquiry_id", id)
      .eq("user_id", state.user.id)
      .maybeSingle(),
    state.client
      .from("deals")
      .select(
        "id,status,currency,deal_value_estimate,buyer_company_id,supplier_company_id",
      )
      .eq("enquiry_id", id)
      .maybeSingle(),
  ]);
[attachments, invites, conversations, saved, deal].forEach((x) =>
  checked(x.error),
);
const category = e.sub_category_id
  ? await state.client
      .from("sub_categories")
      .select("name")
      .eq("id", e.sub_category_id)
      .maybeSingle()
  : null;
if (category) checked(category.error);
const buyer = companies[0];
let canQuote = false;
if (
  state.company &&
  state.company.id !== e.buyer_company_id &&
  state.permissions.includes("sales")
) {
  try {
    await quoteTarget(state, e);
    canQuote = true;
  } catch (error) {
    if (!(error instanceof AccessError) || error.status >= 500) throw error;
  }
}
const supplierOptions =
  owner && e.enquiry_type === "public_rfq"
    ? await state.client
        .rpc("get_company_summaries")
        .eq("verification_status", "verified")
        .neq("id", e.buyer_company_id)
        .order("display_name")
    : null;
if (supplierOptions) checked(supplierOptions.error);
const inviteCompanies = await companySummaries(
  state,
  invites.data?.map((i) => i.supplier_company_id) ?? [],
);
---

<AppLayout
  title={e.title}
  active="enquiries"
  state={state}
  description={"Enquiry #" +
    id +
    " · " +
    (buyer?.display_name ?? "Buyer unavailable")}
>
  <a slot="actions" class="button secondary" href="/app/enquiries?tab=mine"
    >Back to enquiries</a
  >
  <div class="detail-grid">
    <div class="stack">
      <section class="card">
        <div class="card-meta">
          <span class="badge">{e.status}</span><span class="badge"
            >{e.publication_status.replaceAll("_", " ")}</span
          >{e.urgency === "urgent" && <span class="badge urgent">Urgent</span>}{
            buyer?.verification_status === "verified" && (
              <span class="badge success">Verified buyer</span>
            )
          }
        </div>
        <h2 class="mt-5">Requirements</h2><p class="preserve-lines mt-3">
          {e.message}
        </p>
        <dl class="compact-facts mt-5">
          <div>
            <dt>Quantity</dt><dd>
              {quantityLabel(e)}
            </dd>
          </div><div><dt>Delivery</dt><dd>{location(e)}</dd></div><div>
            <dt>Quote deadline</dt><dd>{dateLabel(e.quote_deadline)}</dd>
          </div><div>
            <dt>Category</dt><dd>{category?.data?.name ?? "Not specified"}</dd>
          </div><div><dt>Currency</dt><dd>{e.currency}</dd></div><div>
            <dt>Visibility</dt><dd>
              {
                e.enquiry_type === "direct"
                  ? "Private direct enquiry"
                  : e.visibility === "invited"
                    ? "Invited suppliers"
                    : "Public RFQ"
              }
            </dd>
          </div>
        </dl>
        {
          e.rejection_reason && (
            <p class="form-message mt-5">
              Review feedback: {e.rejection_reason}
            </p>
          )
        }
        <div class="actions">
          {
            canQuote && (
              <a class="button" href={"/app/enquiries/" + id + "/quote"}>
                Submit a quote
              </a>
            )
          }
          {
            owner &&
              openEnquiry(e) &&
              ["draft", "rejected"].includes(e.publication_status) && (
                <>
                  <>
                    <a
                      class="button secondary"
                      href={"/app/enquiries/" + id + "/edit"}
                    >
                      Edit RFQ
                    </a>
                    <ProcurementAction
                      action="review"
                      label="Submit for review"
                      companyId={state.company!.id}
                      enquiryId={id}
                    />
                  </>
                </>
              )
          }
          <form data-api-form action="/api/procurement/saved" method="post">
            <input type="hidden" name="enquiry_id" value={id} /><input
              type="hidden"
              name="saved"
              value={saved.data ? "false" : "true"}
            /><button class="save-button" aria-pressed={!!saved.data}
              >{saved.data ? "Saved" : "Save enquiry"}</button
            ><p data-form-message hidden role="status"></p>
          </form>
        </div>
      </section>
      {
        deal.data &&
          ((deal.data.buyer_company_id === state.company?.id &&
            state.permissions.includes("procurement")) ||
            (deal.data.supplier_company_id === state.company?.id &&
              state.permissions.includes("sales"))) && (
            <section class="card">
              <>
                <h2>Quote accepted</h2>
                <p>
                  Deal #{deal.data.id} · {deal.data.status}. Track delivery and
                  complete your transaction.
                </p>
                <a class="button mt-4" href={"/app/deals/" + deal.data.id}>
                  Open deal
                </a>
              </>
            </section>
          )
      }
      <section class="card">
        <h2>Attachments</h2>{
          Astro.url.searchParams.get("notice") === "storage-cleanup" && (
            <p class="form-message">
              File removed from the enquiry; storage cleanup could not be
              confirmed.
            </p>
          )
        }
        {
          (attachments.data ?? []).length ? (
            <ul class="file-list">
              {attachments.data!.map((a) => (
                <li>
                  <a class="text-link" href={"/api/media/enquiry/" + a.id}>
                    {a.file_name}
                  </a>
                  <span class="muted">
                    {a.file_size_bytes
                      ? Math.ceil(a.file_size_bytes / 1024) + " KB"
                      : ""}
                  </span>
                  {owner && (
                    <form
                      data-api-form
                      action="/api/uploads/remove-enquiry"
                      method="post"
                    >
                      <input
                        type="hidden"
                        name="company_id"
                        value={state.company!.id}
                      />
                      <input type="hidden" name="attachment_id" value={a.id} />
                      <label class="check">
                        <input
                          type="checkbox"
                          required
                          name="confirm"
                          value="REMOVE"
                        />
                        Confirm removal
                      </label>
                      <button class="button secondary">Remove</button>
                      <p data-form-message hidden role="status" />
                    </form>
                  )}
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted mt-3">No files available to your company.</p>
          )
        }
        {
          owner &&
            openEnquiry(e) &&
            e.publication_status !== "pending_review" && (
              <form class="form" data-file-form data-kind="enquiry">
                <>
                  <input type="hidden" name="target_id" value={id} />
                  <input
                    type="hidden"
                    name="company_id"
                    value={state.company!.id}
                  />
                  <label class="field">
                    Add attachment
                    <input
                      type="file"
                      accept="image/jpeg,image/png,image/webp,application/pdf"
                      required
                    />
                  </label>
                  <p class="help-text">JPEG, PNG, WebP or PDF, under 10 MB.</p>
                  <button class="button secondary">Upload file</button>
                  <p data-form-message hidden role="status" />
                </>
              </form>
            )
        }
      </section>
      <div class="section-heading">
        <h2>Quotes ({bundle.quotes.length})</h2>{
          bundle.quotes.length > 0 && (
            <div class="actions">
              <>
                <a
                  class="button secondary"
                  href={"/app/enquiries/" + id + "/compare"}
                >
                  Compare quotes
                </a>
                <a class="text-link" href={"/app/enquiries/" + id + "/export"}>
                  Export all quotes
                </a>
              </>
            </div>
          )
        }
      </div>
      {
        bundle.quotes.length ? (
          bundle.quotes.map((q) => (
            <QuoteCard
              state={state}
              quote={q}
              enquiry={e}
              profile={
                bundle.profiles.find((p) => p.id === q.supplier_company_id)
                  ?.profile ?? null
              }
            />
          ))
        ) : (
          <div class="card">
            <p>No quotes available yet.</p>
          </div>
        )
      }
    </div>
    <aside class="stack">
      <section class="card">
        <h2>Conversations</h2>{
          (conversations.data ?? [])
            .filter((c) =>
              [c.buyer_company_id, c.supplier_company_id].includes(
                state.company?.id ?? -1,
              ),
            )
            .map((c) => (
              <a class="settings-link" href={"/app/messages/" + c.id}>
                Open conversation #{c.id}
              </a>
            ))
        }{
          !conversations.data?.length && (
            <p class="muted mt-3">
              A conversation opens with a direct enquiry or supplier quote.
            </p>
          )
        }
      </section>
      {
        owner && e.enquiry_type === "public_rfq" && (
          <section class="card">
            <ul class="settings-list">
              {(invites.data ?? []).map((i) => (
                <li>
                  {inviteCompanies.find((c) => c.id === i.supplier_company_id)
                    ?.display_name ?? "Supplier unavailable"}{" "}
                  <span class="badge">{i.status}</span>
                </li>
              ))}
            </ul>
            {openEnquiry(e) && (
              <form
                class="form"
                data-api-form
                action="/api/procurement/invite"
                method="post"
              >
                <input
                  type="hidden"
                  name="company_id"
                  value={state.company!.id}
                />
                <input type="hidden" name="enquiry_id" value={id} />
                <label class="field">
                  Invite a supplier
                  <select name="supplier_company_id" required>
                    <option value="">Choose supplier</option>
                    {supplierOptions?.data?.map((c) => (
                      <option value={c.id}>{c.display_name}</option>
                    ))}
                  </select>
                </label>
                <button class="button secondary">Send invitation</button>
                <p data-form-message hidden role="status" />
              </form>
            )}
          </section>
        )
      }
      {
        owner && openEnquiry(e) && (
          <details class="card">
            <>
              <summary>Close or cancel enquiry</summary>
              <p class="muted mt-3">
                Suppliers will no longer be able to quote.
              </p>
              <div class="stack mt-5">
                <>
                  <ProcurementAction
                    action="close"
                    label="Close enquiry"
                    companyId={state.company!.id}
                    enquiryId={id}
                    confirm
                    secondary
                  />
                  <ProcurementAction
                    action="cancel"
                    label="Cancel enquiry"
                    companyId={state.company!.id}
                    enquiryId={id}
                    confirm
                    secondary
                  />
                </>
              </div>
            </>
          </details>
        )
      }
    </aside>
  </div>
</AppLayout>
<script>
  import { bindProcurementForms } from "../../../../scripts/procurement";
  bindProcurementForms();
</script>
