---
import AppLayout from "../../../layouts/AppLayout.astro";
import CompanyForm from "../../../components/CompanyForm.astro";
import { requireWorkspace } from "../../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout title="Create a company" active="account" state={state}
  ><section class="card reading">
    <h2>Your company workspace</h2><p class="help-text">
      Use the same company on web and in the app.
    </p><CompanyForm
      email={state.user.email ?? ""}
      intent={Astro.cookies.get("ss-intent")?.value}
    />
  </section></AppLayout
>
