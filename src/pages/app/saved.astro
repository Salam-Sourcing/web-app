---
import AppLayout from "../../layouts/AppLayout.astro";
import CatalogFeed from "../../components/CatalogFeed.astro";
import { requireWorkspace } from "../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout
  title="Saved items"
  active="discover"
  state={state}
  description="Your private shortlist is shared with the Salam Sourcing app."
>
  <a slot="actions" class="button secondary" href="/app/discover"
    >Back to Discover</a
  >
  <CatalogFeed state={state} saved={true} />
</AppLayout>
