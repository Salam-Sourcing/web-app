---
import AppLayout from "../../../../layouts/AppLayout.astro";
import { requireWorkspace } from "../../../../lib/server/access";
import { dealBundle } from "../../../../lib/server/deals";
import { positiveId } from "../../../../lib/security";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
await dealBundle(state, id);
const url = "/api/deals/" + id + "/export";
---

<AppLayout title={"Deal #" + id + " summary"} active="enquiries" state={state}>
  <a slot="actions" class="button secondary" href={"/app/deals/" + id}
    >Back to deal</a
  >
  <section
    class="card"
    data-pdf-export
    data-url={url}
    data-filename={"salam-deal-" + id + ".pdf"}
  >
    <p class="help-text">
      Business summary only. This is not an invoice, payment receipt or proof of
      delivery. Export only when you intend to save or share this record.
    </p><div class="actions mt-4">
      <a class="button" href={url}>Download PDF</a><a
        class="button secondary"
        href={url + "?preview=1"}
        target="_blank"
        rel="noopener noreferrer">Open / print PDF ↗</a
      ><button class="button secondary" type="button" data-share hidden
        >Share PDF</button>
    </div><p data-export-status hidden role="status"></p><iframe
      class="pdf-preview"
      title={"PDF preview of deal " + id}
      src={url + "?preview=1"}></iframe><p class="help-text">
      If your browser cannot display this preview, use Download PDF or Open /
      print PDF.
    </p>
  </section>
</AppLayout>
<script>
  import { bindPdfShare } from "../../../../scripts/deals";
  bindPdfShare();
</script>
