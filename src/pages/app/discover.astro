---
import AppLayout from "../../layouts/AppLayout.astro";
import CatalogFeed from "../../components/CatalogFeed.astro";
import { requireWorkspace } from "../../lib/server/access";
const state = await requireWorkspace(Astro);
---

<AppLayout
  title="Discover"
  active="discover"
  state={state}
  description="Find products, services and suppliers for your business."
>
  <a slot="actions" class="button secondary" href="/app/saved"
    >Saved listings &amp; suppliers</a
  >
  <CatalogFeed state={state} />
</AppLayout>
