---
import AppLayout from "../../../layouts/AppLayout.astro";
import CatalogFeed from "../../../components/CatalogFeed.astro";
import SaveButton from "../../../components/SaveButton.astro";
import { requireWorkspace } from "../../../lib/server/access";
import {
  publicCompany,
  checked,
  contactAllowed,
} from "../../../lib/server/catalog";
import { positiveId } from "../../../lib/security";
import { website } from "../../../lib/catalog";
const state = await requireWorkspace(Astro),
  id = positiveId(Astro.params.id);
let profile: Awaited<ReturnType<typeof publicCompany>> | undefined,
  error: string | undefined;
try {
  profile = await publicCompany(state, id);
} catch (e) {
  error = e instanceof Error ? e.message : "This supplier is unavailable.";
}
const saved = profile
  ? await state.client
      .from("saved_companies")
      .select("id")
      .eq("company_id", id)
      .eq("user_id", state.user.id)
      .maybeSingle()
  : null;
if (saved) checked(saved.error);
let link: string | null = null;
try {
  link = website(profile?.website);
} catch {}
---

<AppLayout
  title={profile?.display_name ?? "Supplier unavailable"}
  active="discover"
  state={state}
  >{
    profile ? (
      <>
        <>
          <section class="card supplier-overview">
            <>
              <div>
                <p class="preserve-lines mt-4">{profile.description}</p>
                {link && (
                  <a
                    class="text-link mt-4"
                    href={link}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Visit company website ↗
                  </a>
                )}
              </div>
              <aside>
                <>
                  <dl>
                    <>
                      <div class="info-row">
                        <>
                          <dt>Average rating</dt>
                          <dd>
                            {profile.total_reviews
                              ? Number(profile.average_rating).toFixed(1) +
                                " / 5"
                              : "No reviews yet"}
                          </dd>
                        </>
                      </div>
                      <div class="info-row">
                        <>
                          <dt>Reviews</dt>
                          <dd>{profile.total_reviews}</dd>
                        </>
                      </div>
                      <div class="info-row">
                        <>
                          <dt>Published listings</dt>
                          <dd>{profile.total_listings}</dd>
                        </>
                      </div>
                    </>
                  </dl>
                  <div class="actions">
                    <SaveButton
                      id={id}
                      kind="company"
                      saved={Boolean(saved?.data)}
                      name={profile.display_name}
                    />
                    {contactAllowed(state, id) && (
                      <a
                        class="button"
                        href={"/app/enquiries/new?supplier=" + id}
                      >
                        Contact supplier
                      </a>
                    )}
                    <a
                      class="text-link"
                      href={"/app/account/report?type=company&id=" + id}
                    >
                      Report company
                    </a>
                    {state.company?.id !== id && (
                      <a
                        class="text-link"
                        href={"/app/account/block?company=" + id}
                      >
                        Block company
                      </a>
                    )}
                  </div>
                </>
              </aside>
            </>
          </section>
          <h2 class="mt-8 mb-6">Supplier listings</h2>
          <CatalogFeed state={state} companyId={id} />
        </>
      </>
    ) : (
      <section class="card empty-state">
        <>
          <h2>Supplier unavailable</h2>
          <p role="status">{error}</p>
          <div class="actions justify-center">
            <>
              <a class="button secondary" href={Astro.url.pathname}>
                Retry
              </a>
              <a class="text-link" href="/app/saved?tab=suppliers">
                Manage saved suppliers
              </a>
              <a class="text-link" href="/app/discover">
                Discover
              </a>
            </>
          </div>
        </>
      </section>
    )
  }</AppLayout
>
