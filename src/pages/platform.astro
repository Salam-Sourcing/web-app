---
import MainLayout from "../layouts/MainLayout.astro";
import Icon from "../components/Icon.astro";
import MarketplacePreview from "../components/MarketplacePreview.astro";
const features = [
  {
    icon: "discover",
    title: "Discovery that fits your requirements",
    body: "Explore products and services, then search by supplier, location, price, minimum order and lead time. Save the suppliers, listings and filters you want to return to.",
    href: "/buyers",
    link: "Explore sourcing tools",
  },
  {
    icon: "enquiries",
    title: "Give your request the right context",
    body: "Send a direct enquiry to a supplier or prepare a public request for quotes. Include quantities, delivery details, deadlines and attachments, and invite relevant suppliers to respond.",
    href: "/buyers",
    link: "See the buyer journey",
  },
  {
    icon: "layers",
    title: "Compare more than the price",
    body: "Review quotes side by side with their original currencies, lead times, payment terms and validity. Follow revisions, export a PDF and accept the terms that suit your business.",
    href: "/buyers",
    link: "Understand quote comparison",
  },
  {
    icon: "messages",
    title: "A conversation with the details attached",
    body: "Keep your enquiry and messages together. Share captioned photos and PDFs, open images in the viewer and return to conversation history when you need the context.",
    href: "/get-the-app",
    link: "Take conversations with you",
  },
  {
    icon: "truck",
    title: "Follow the work after the agreement",
    body: "Keep preparation, shipping, delivery details and deal documents in one place. Each company confirms completion separately before eligible transaction reviews.",
    href: "/vendors",
    link: "Explore deal tools",
  },
  {
    icon: "team",
    title: "Your company, working together",
    body: "Manage buying and selling from the same company workspace. Invite teammates, assign roles and permissions, switch companies and see activity through buyer dashboards and supplier insights.",
    href: "/vendors",
    link: "See workspace features",
  },
];
const steps = [
  {
    icon: "company",
    title: "Introduce your business",
    body: "Create your account and company profile. Add the information buyers and suppliers need to get to know you.",
  },
  {
    icon: "discover",
    title: "Find your next opportunity",
    body: "Explore supply, publish your catalogue or describe what you need in an enquiry.",
  },
  {
    icon: "layers",
    title: "Agree on the details",
    body: "Exchange messages and quotes. Compare the terms before deciding how to move forward.",
  },
  {
    icon: "truck",
    title: "Keep the work connected",
    body: "Track the deal, share documents and build a record of completed business relationships.",
  },
];
const questions = [
  [
    "Can my company buy and sell?",
    "Yes. The same company workspace supports procurement and sales. Your team’s permissions determine which actions each member can use.",
  ],
  [
    "Can I browse before creating an account?",
    "Yes. Browse the public marketplace first. Sign in when you want to search, apply filters, see full product details or contact a business.",
  ],
  [
    "What does company verification mean?",
    "A verification check means submitted business identity documents were reviewed. It is one useful signal, alongside company information, eligible reviews and your own due diligence. It does not guarantee a transaction.",
  ],
  [
    "Does the platform handle payment or shipping?",
    "Participating businesses agree their own prices, contracts, payment and delivery arrangements. The workspace helps record conversations, quotes and deal progress.",
  ],
];
---

<MainLayout
  title="About Salam Sourcing B2B Marketplace"
  description="A connected B2B workspace for discovering supply, comparing quotes, managing company catalogues and following deals. Explore what Salam Sourcing B2B Marketplace offers buyers and vendors."
>
  <section class="marketing-hero">
    <div class="container marketing-hero-grid">
      <div class="marketing-enter">
        <p class="marketing-kicker">
          <Icon name="briefcase" size={17} />Built for business-to-business
          connections
        </p><h1>
          Find the right supply.<br /><span
            >Keep the whole journey together.</span
          >
        </h1><p class="lead">
          Salam Sourcing B2B Marketplace is a business-to-business marketplace
          connecting companies that need products and services with the
          businesses that supply them. Products, enquiries, quotes and
          conversations come together in your company workspace.
        </p><div class="actions">
          <a class="button" href="/buyers"
            >I’m buying<Icon name="arrow" size={18} /></a
          ><a class="button secondary" href="/vendors"
            >I’m supplying<Icon name="box" size={18} /></a
          >
        </div><div class="marketing-assurances">
          <span><Icon name="check" size={16} />Products &amp; services</span
          ><span><Icon name="check" size={16} />Web &amp; mobile</span><span
            ><Icon name="check" size={16} />Buy, sell or both</span
          >
        </div>
      </div>
      <MarketplacePreview />
    </div>
  </section>
  <section
    class="container marketing-section"
    aria-labelledby="platform-features"
  >
    <div class="marketing-heading">
      <p class="eyebrow">More than a listing</p><h2 id="platform-features">
        Useful tools at every step.
      </h2><p>
        Start with the opportunity. Keep the requirements, people and decisions
        connected as your business moves forward.
      </p>
    </div><div class="audience-feature-grid">
      {
        features.map((feature) => (
          <article class="card marketing-card">
            <>
              <span class="audience-feature-icon">
                <Icon name={feature.icon} size={24} />
              </span>
              <h3>{feature.title}</h3>
              <p>{feature.body}</p>
              <a class="text-link" href={feature.href}>
                {feature.link}
                <Icon name="arrow" size={16} />
              </a>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="container marketing-section">
    <div class="marketing-heading">
      <p class="eyebrow">Built around your role</p><h2>
        One marketplace. Both sides of the conversation.
      </h2>
    </div><div class="marketing-role-grid">
      <a class="card marketing-role" href="/buyers"
        ><Icon name="discover" size={32} /><p class="eyebrow">For Buyers</p><h3>
          Bring your requirements. Find your next supplier.
        </h3><p>
          Shortlist options, request quotes, compare terms and follow active
          enquiries in your buyer dashboard.
        </p><span class="text-link"
          >Explore buyer features<Icon name="arrow" size={18} /></span
        ></a
      ><a class="card marketing-role" href="/vendors"
        ><Icon name="sell" size={32} /><p class="eyebrow">For Vendors</p><h3>
          Show what you supply. Build the next relationship.
        </h3><p>
          Manage your catalogue, respond to enquiries, send quotes and
          understand your recorded supplier activity.
        </p><span class="text-link"
          >Explore vendor features<Icon name="arrow" size={18} /></span
        ></a
      >
    </div>
  </section>
  <section class="marketing-band">
    <div class="container marketing-section">
      <div class="marketing-heading">
        <p class="eyebrow">A clearer way to work</p><h2>
          From a first look to a shared next step.
        </h2>
      </div><ol class="marketing-steps">
        {
          steps.map((step, index) => (
            <li>
              <>
                <span class="marketing-step-number">0{index + 1}</span>
                <Icon name={step.icon} size={25} />
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class="container marketing-section">
    <div class="marketing-split">
      <div>
        <p class="eyebrow">Confidence comes from context</p><h2>
          Get to know the business behind the offer.
        </h2><p class="lead">
          Company profiles bring together business information, company photos,
          catalogues and eligible ratings out of five. Verification is explained
          clearly, so you can understand what was reviewed.
        </p><div class="actions">
          <a class="button secondary" href="/verification"
            ><Icon name="shield" size={18} />What verification means</a
          >
        </div>
      </div><div class="card marketing-trust">
        <div>
          <Icon name="shield" /><h3>Account protection</h3><p>
            Optional authenticator two-factor security and private company
            permissions.
          </p>
        </div><div>
          <Icon name="flag" /><h3>Tools when something feels wrong</h3><p>
            Report listings, messages and reviews, block a business or contact
            support.
          </p>
        </div><div>
          <Icon name="star" /><h3>Feedback tied to eligible deals</h3><p>
            Read company reviews and responses alongside the rest of the
            business profile.
          </p>
        </div>
      </div>
    </div>
  </section>
  <section class="container marketing-app-callout">
    <div>
      <p class="eyebrow">One account, wherever work takes you</p><h2>
        Your marketplace workspace is going mobile.
      </h2><p>
        Explore what the iOS and Android app brings to sourcing, messages and
        company management. Public downloads are coming soon; your workspace is
        available on the web today.
      </p><a class="button" href="/get-the-app"
        ><Icon name="phone" size={18} />Meet the app<Icon
          name="arrow"
          size={18}
        /></a
      >
    </div><span class="marketing-callout-icon"
      ><Icon name="phone" size={76} /></span
    >
  </section>
  <section class="container marketing-section">
    <div class="marketing-heading">
      <p class="eyebrow">A few things to know</p><h2>
        Your questions, answered.
      </h2>
    </div><div class="marketing-faq">
      {
        questions.map(([question, answer]) => (
          <details>
            <>
              <summary>
                {question}
                <Icon name="plus" size={19} />
              </summary>
              <p>{answer}</p>
            </>
          </details>
        ))
      }
    </div>
  </section>
  <section class="container marketing-bottom">
    <p class="eyebrow">Your next connection starts here</p><h2>
      Bring your business to the marketplace.
    </h2><div class="actions">
      <a class="button" href="/signup"
        >Create your account<Icon name="arrow" size={18} /></a
      ><a class="button secondary" href="/">Browse first</a>
    </div>
  </section>
</MainLayout>
