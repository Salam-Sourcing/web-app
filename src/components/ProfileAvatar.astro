---
import MediaImage from "./MediaImage.astro";
const { name = "Your account", photo = false, large = false } = Astro.props;
const initials =
  String(name)
    .trim()
    .split(/\s+/)
    .slice(0, 2)
    .map((p) => Array.from(p)[0] ?? "")
    .join("")
    .toUpperCase() || "A";
---

<span
  class:list={["personal-avatar", { "avatar-large": large }]}
  aria-hidden="true"
  >{initials}{
    photo && (
      <MediaImage src="/api/media/profile/me" alt="" data-private-media />
    )
  }</span
>
