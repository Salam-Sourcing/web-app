---
import Icon from "./Icon.astro";
const { id = "company-verification-note" } = Astro.props as { id?: string };
---

<span class="verification-badge" data-verification-badge>
  <button
    type="button"
    class="verification-check"
    aria-label="About this company’s verification"
    aria-expanded="false"
    aria-controls={id}
    ><Icon name="shield" size={21} /><span>Verified company</span></button
  >
  <span id={id} class="verification-note" data-verification-note hidden>
    <strong>This company is verified</strong>
    <span
      >Salam Sourcing B2B Marketplace has reviewed and approved its submitted
      business identity documents.</span
    >
    <a class="text-link" href="/verification"
      >Learn more <Icon name="arrow" size={15} /></a
    >
  </span>
</span>
<script>
  import { bindVerificationBadges } from "../scripts/verification";
  bindVerificationBadges();
</script>
