---
import BrandLogo from "./BrandLogo.astro";
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a
        class="brand"
        href="/"
        aria-label="Salam Sourcing B2B Marketplace home"
      >
        <BrandLogo />
      </a>
      <p>
        A B2B marketplace connecting business buyers and suppliers. Discover
        products and services, exchange quotes and keep your company’s sourcing
        conversations in one place.
      </p>
    </div>
    <nav
      class="footer-column"
      aria-label="Explore Salam Sourcing B2B Marketplace"
    >
      <h2>Explore</h2>
      <a href="/">Browse the marketplace</a>
      <a href="/buyers">For Buyers</a><a href="/vendors">For Vendors</a><a
        href="/get-the-app">Get the app</a
      ><a href="/platform">About Salam Sourcing B2B Marketplace</a>
      <a href="/about">How it works</a>
      <a href="/plans">Our plans</a>
    </nav>
    <nav class="footer-column" aria-label="Help and information">
      <h2>Help &amp; information</h2>
      <a href="/help">Support</a>
      <a href="/verification">Company verification</a>
      <a href="/terms">Terms of service</a>
      <a href="/privacy">Privacy policy</a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <p>
      © {new Date().getFullYear()} Salam Sourcing B2B Marketplace. All rights reserved.
    </p>
    <span>Built for better business.</span>
  </div>
</footer>
