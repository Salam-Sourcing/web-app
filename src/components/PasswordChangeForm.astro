<div class="password-change-flow">
  <form
    class="form password-verification-card"
    data-api-form
    data-password-code-form
    method="post"
    action="/api/auth/reauthenticate"
    aria-labelledby="password-code-heading"
  >
    <h3 id="password-code-heading">Need an email verification code?</h3>
    <p>
      If verification is requested, send a code to your account email, then
      enter the latest code below. The code is in addition to your current
      password.
    </p>
    <button class="button secondary" type="submit" data-password-send-code>
      Send verification code
    </button>
    <p class="form-message" data-form-message role="status" hidden></p>
  </form>
  <form
    class="form"
    data-api-form
    data-password-form
    method="post"
    action="/api/auth/password"
  >
    <label class="field"
      >Current password
      <input
        data-password-field
        name="current_password"
        type="password"
        aria-label="Current password"
        autocomplete="current-password"
        maxlength="4096"
        aria-describedby="current-password-help"
      />
      <small id="current-password-help">
        Required for a regular password change. Leave blank if you opened a
        password recovery link. <a class="text-link" href="/forgot-password"
          >Forgot your password?</a
        >
      </small>
    </label>
    <label class="field"
      >New password
      <input
        data-password-field
        name="password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        maxlength="128"
        required
      />
    </label>
    <label class="field"
      >Confirm new password
      <input
        data-password-field
        name="confirm_password"
        type="password"
        autocomplete="new-password"
        minlength="8"
        maxlength="128"
        required
      />
    </label>
    <label class="field"
      >Email verification code
      <input
        name="nonce"
        autocomplete="one-time-code"
        inputmode="numeric"
        maxlength="128"
        aria-describedby="password-code-help"
      />
      <small id="password-code-help" data-password-code-help>
        Only required when verification is requested. Use Send verification code
        above to get one.
      </small>
    </label>
    <p class="form-message" data-form-message role="status" hidden></p>
    <button class="button" type="submit">Update password</button>
  </form>
</div>

<style>
  .password-change-flow {
    display: grid;
    gap: 24px;
  }
  .password-verification-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface-soft, #f5f6f8);
  }
  .password-verification-card h3 {
    margin: 0;
    font-size: 17px;
  }
  .password-verification-card > p:not(.form-message) {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }
  .password-verification-card .button {
    justify-self: start;
  }
  .field small {
    color: var(--muted);
    font-weight: 400;
    line-height: 1.6;
  }
</style>
