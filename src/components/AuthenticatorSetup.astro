---
import Icon from "./Icon.astro";
interface Props {
  hidden?: boolean;
}
const { hidden = true } = Astro.props;
---

<section
  id="authenticator-setup"
  class="authenticator-setup"
  hidden={hidden}
  aria-label="Authenticator setup"
>
  <div class="security-step-heading">
    <span>1</span><div>
      <h3>Add your authenticator</h3><p>
        Open your authenticator app and choose to add an account.
      </p>
    </div>
  </div>
  <div class="authenticator-methods">
    <div class="authenticator-scan">
      <h4><Icon name="phone" size={18} />Scan the QR code</h4><img
        class="qr-image"
        id="authenticator-qr"
        alt="QR code for your authenticator app"
      /><p class="help-text">Use your authenticator app’s scanner.</p><p
        id="qr-warning"
        class="help-text"
        role="status"
        hidden
      >
      </p>
    </div>
    <div class="authenticator-manual">
      <h4><Icon name="lock" size={18} />Or enter the setup key</h4><p
        class="help-text"
      >
        Choose manual entry in the app if scanning isn’t convenient. Keep this
        key private.
      </p><label class="field"
        >Setup key<input
          id="authenticator-secret"
          data-secret-control
          type="password"
          readonly
          autocomplete="off"
          spellcheck="false"
        /></label
      ><div class="row-actions authenticator-key-actions">
        <button
          class="button secondary"
          type="button"
          data-reveal-key
          aria-pressed="false"
          disabled>Show key</button
        ><button class="button secondary" type="button" data-copy-key disabled
          >Copy setup key</button
        >
      </div><p class="help-text" data-key-message role="status"></p>
    </div>
  </div>
  <div class="security-step-heading">
    <span>2</span><div>
      <h3>Confirm it’s connected</h3><p>
        Enter the current six-digit code shown in your authenticator app.
      </p>
    </div>
  </div>
  <form
    class="form authenticator-verification"
    id="enrollment-verification"
    data-api-form
    method="post"
    action="/api/auth/mfa-verify"
  >
    <input type="hidden" name="factor_id" /><input
      type="hidden"
      name="purpose"
      value="enrollment"
    /><input type="hidden" name="next" value="/account/password" />
    <label class="field"
      >Six-digit code<input
        class="authenticator-code"
        name="code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]{6}"
        maxlength="6"
        minlength="6"
        placeholder="000000"
        required
        aria-describedby="authenticator-code-tip"
      /></label
    >
    <p class="help-text" id="authenticator-code-tip">
      If a code is about to change, wait for the next one. Keep your phone’s
      date and time set automatically.
    </p>
    <p class="form-message" data-form-message role="status" hidden></p><button
      class="button"
      type="submit"><Icon name="shield" size={18} />Verify and enable</button
    >
  </form>
  <form
    class="form authenticator-cancel"
    id="enrollment-cancel"
    data-api-form
    method="post"
    action="/api/auth/mfa-cancel"
  >
    <input type="hidden" name="factor_id" /><p
      class="form-message"
      data-form-message
      role="status"
      hidden
    >
    </p><button class="button secondary" type="submit">Cancel setup</button>
  </form>
  <p class="security-private-note">
    <Icon name="lock" size={16} />Don’t share this QR code, setup key or
    verification codes with anyone.
  </p>
</section>
