---
import ListingPrice from "./ListingPrice.astro";
import MediaImage from "./MediaImage.astro";
import type { ListingCardData } from "../lib/catalog";
import SaveButton from "./SaveButton.astro";
import Icon from "./Icon.astro";
interface Props {
  listing: ListingCardData;
}
const { listing } = Astro.props;
---

<article class="listing-card" data-record-id={listing.id}>
  <div class="listing-picture">
    <a href={"/listings/" + listing.id} aria-label={"View " + listing.name}
      ><Icon name="image" size={36} />{
        listing.has_image && (
          <MediaImage
            data-private-media
            src={"/api/media/listing/" + listing.id}
            alt={listing.name}
            loading="lazy"
          />
        )
      }</a
    >
  </div>
  <div class="listing-card-body">
    <a class="eyebrow supplier-link" href={"/suppliers/" + listing.company_id}
      >{listing.vendor_name}</a
    ><h2><a href={"/listings/" + listing.id}>{listing.name}</a></h2>{
      listing.category && <p class="help-text">{listing.category}</p>
    }
    <div class="listing-facts">
      {
        listing.price_per_unit !== null && (
          <ListingPrice
            amount={listing.price_per_unit}
            currency={listing.currency}
            unit={listing.unit_of_measure}
          />
        )
      }{
        listing.minimum_order_quantity !== null && (
          <p>
            MOQ: {listing.minimum_order_quantity} {listing.unit_of_measure}
          </p>
        )
      }{listing.location && <p>{listing.location}</p>}
    </div>
    <SaveButton
      id={listing.id}
      kind="listing"
      saved={listing.saved}
      name={listing.name}
    />
  </div>
</article>
