---
import { countryFlagCode } from "../lib/country-flags";
interface Props {
  country: string | null | undefined;
  label?: string;
}
const { country, label } = Astro.props;
const code = countryFlagCode(country);
const text = label ?? country?.trim() ?? "";
---

{
  text && (
    <span class="country-label">
      {code && (
        <img
          src={`/flags/${code}.svg`}
          width="24"
          height="18"
          alt=""
          aria-hidden="true"
        />
      )}
      <span>{text}</span>
    </span>
  )
}

<style>
  .country-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    max-width: 100%;
    vertical-align: middle;
  }
  .country-label img {
    flex: 0 0 auto;
    object-fit: contain;
  }
  .country-label span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>
