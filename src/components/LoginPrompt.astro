<dialog
  class="login-prompt"
  data-login-prompt
  aria-labelledby="login-prompt-title"
>
  <button
    class="prompt-close"
    type="button"
    data-close-prompt
    aria-label="Close sign-in prompt">✕</button
  >
  <div class="prompt-symbol" aria-hidden="true">↗</div>
  <p class="eyebrow">Your next business connection</p>
  <h2 id="login-prompt-title">Sign in to keep exploring</h2>
  <p data-prompt-reason>
    View product details and connect with suppliers using your Salam Sourcing
    Marketplace account.
  </p>
  <div class="prompt-actions">
    <a class="button" data-prompt-login href="/login">Sign in</a>
    <a class="button secondary" data-prompt-signup href="/signup"
      >Create an account</a
    >
  </div>
  <p class="help-text">
    Already using our mobile app? Sign in with the same account.
  </p>
</dialog>
