---
import BrandLogo from "./BrandLogo.astro";
const links = [
  { href: "/", label: "Browse" },
  { href: "/buyers", label: "Buyers" },
  { href: "/vendors", label: "Vendors" },
  { href: "/platform", label: "About" },
  { href: "/plans", label: "Plans" },
];
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/" aria-label="Salam Sourcing B2B Marketplace home">
      <BrandLogo />
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={Astro.url.pathname === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a class="button secondary" href="/login">Log in</a>
      <a class="button" href="/signup" aria-label="Join free"
        >Join<span class="join-extra"> free</span></a
      >
    </div>
  </div>
  <details class="container mobile-menu">
    <summary>Explore the B2B marketplace</summary><nav
      aria-label="Mobile navigation"
    >
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </details>
</header>
