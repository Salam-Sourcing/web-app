---
const links = [
  { href: "/", label: "Browse" },
  { href: "/buyers", label: "Buyers" },
  { href: "/vendors", label: "Vendors" },
  { href: "/platform", label: "About Salam Sourcing" },
  { href: "/plans", label: "Plans" },
];
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/" aria-label="Salam Sourcing home"
      ><img
        src="/images/salam-sourcing.png"
        alt=""
        width="52"
        height="52"
      /><span class="brand-wordmark">Salam<small>Sourcing</small></span></a
    >
    <nav class="site-nav" aria-label="Main navigation">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={Astro.url.pathname === link.href ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="header-actions">
      <a class="button secondary" href="/login">Log in</a>
      <a class="button" href="/signup">Join free</a>
    </div>
  </div>
  <details class="container mobile-menu">
    <summary>Explore Salam Sourcing</summary><nav
      aria-label="Mobile navigation"
    >
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </details>
</header>
