---
import AppDownloadBanner from "../components/AppDownloadBanner.astro";
import "../styles/globals.css";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import Footer from "../components/Footer.astro";
import { profilePhoto } from "../lib/server/profile-photo";
import Icon from "../components/Icon.astro";
import type { Workspace } from "../lib/server/access";
import { fingerprint } from "../lib/server/access";
interface Props {
  title: string;
  active: string;
  state: Workspace;
  description?: string;
}
const { title, active, state, description } = Astro.props;
const avatar = await profilePhoto(state).catch(() => null);
const accountName =
  [state.profile.first_name, state.profile.last_name]
    .filter(Boolean)
    .join(" ") || "Your account";
const destinations = [
  ["discover", "Discover"],
  ["enquiries", "Enquiries"],
  ["sell", "Sell"],
  ["messages", "Messages"],
  ["account", "Account"],
];
---

<!doctype html>
<html lang="en">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    /><meta name="robots" content="noindex,nofollow,noarchive" /><meta
      name="theme-color"
      content="#9C272E"
    /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="preload"
      href="/fonts/Inter.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    /><title>{title} | Salam Sourcing Marketplace</title></head
  >
  <body class="workspace-body">
    <div id="private-content" data-fingerprint={fingerprint(state)}>
      <a class="skip-link" href="#main">Skip to content</a>
      <AppDownloadBanner /><header class="workspace-header">
        <div class="container header-row">
          <a
            class="brand"
            href="/"
            aria-label="Salam Sourcing Marketplace Discover"
            ><img
              src="/images/salam-sourcing.png"
              alt=""
              width="52"
              height="52"
            /><span class="brand-wordmark"
              >Salam<small>Sourcing</small><span class="brand-marketplace"
                >Marketplace</span
              ></span
            ></a
          >
          <nav class="workspace-nav" aria-label="Marketplace navigation">
            {
              destinations
                .filter(([key]) => key !== "account")
                .map(([key, label]) => (
                  <a
                    class:list={{ "nav-sell": key === "sell" }}
                    href={"/" + key}
                    aria-current={key === active ? "page" : undefined}
                  >
                    <span class="nav-icon">
                      <Icon name={key} />
                    </span>
                    {label}
                  </a>
                ))
            }
          </nav>
          <div class="workspace-account-actions">
            <a
              href="/account/notifications"
              class="notification-bell"
              data-notification-bell
              aria-label="Notifications"
              ><Icon name="bell" /><span
                data-notification-count
                class="notification-count"
                hidden></span></a
            >
            <details class="account-menu" data-account-menu>
              <summary
                role="button"
                aria-label="Open account menu"
                aria-expanded="false"
                ><ProfileAvatar
                  name={accountName}
                  photo={Boolean(avatar)}
                /><span class="account-menu-chevron" aria-hidden="true">⌄</span
                ></summary
              >
              <div class="account-dropdown">
                <div class="dropdown-identity">
                  <strong>{accountName}</strong><span
                    >{state.profile.email}</span
                  >
                </div>
                <nav aria-label="Account navigation">
                  <a href="/account"><Icon name="account" />Account</a>
                  <a href="/account/profile"
                    ><Icon name="account" />Profile information</a
                  >
                  <a href="/saved"
                    ><Icon name="heart" />Saved listings &amp; suppliers</a
                  >
                  <a href="/account/team"
                    ><Icon name="team" />Company workspace</a
                  >
                  <a href="/account/security"><Icon name="shield" />Security</a>
                  <a href="/account/support"><Icon name="help" />Support</a>
                </nav>
                <form data-api-form action="/api/auth/logout" method="post">
                  <button type="submit" class="dropdown-signout"
                    >Sign out</button
                  ><p data-form-message role="status" hidden></p>
                </form>
              </div>
            </details>
          </div>
          {
            state.companies.length > 1 && (
              <form
                class="company-control"
                data-api-form
                action="/api/company"
                method="post"
              >
                <>
                  <label class="field">
                    Active company
                    <select name="company_id" aria-label="Active company">
                      {state.companies.map((company) => (
                        <option
                          value={company.id}
                          selected={company.id === state.company?.id}
                        >
                          {company.display_name}
                        </option>
                      ))}
                    </select>
                  </label>
                  <button type="submit" class="button secondary">
                    Switch
                  </button>
                  <p
                    data-form-message
                    class="form-message"
                    role="status"
                    hidden
                  />
                </>
              </form>
            )
          }
        </div>
      </header>
      <main id="main" class="container workspace-content">
        <div class="workspace-heading">
          <div>
            <h1>{title}</h1>{
              description && <p class="workspace-description">{description}</p>
            }
          </div>
          {
            Astro.slots.has("actions") && (
              <div class="page-actions">
                <slot name="actions" />
              </div>
            )
          }
        </div><slot />
      </main>
      <Footer />
      <nav class="mobile-dock" aria-label="Marketplace mobile navigation">
        {
          destinations.map(([key, label]) => (
            <a
              class:list={{ "nav-sell": key === "sell" }}
              href={"/" + key}
              aria-current={key === active ? "page" : undefined}
            >
              <>
                <span class="nav-icon">
                  <Icon name={key} />
                </span>
                <span>{label}</span>
              </>
            </a>
          ))
        }
      </nav>
    </div>
    <div id="boundary-overlay" class="boundary-overlay" hidden>
      <div class="card">
        <h2>Checking your account access</h2><p id="boundary-message">
          Please wait while we verify your session.
        </p><div class="actions">
          <button type="button" class="button" id="boundary-retry">Retry</button
          ><a class="text-link" href="/login">Back to log in</a>
        </div>
      </div>
    </div>
  </body>
</html>
<script>
  import { bindPushLogout } from "../scripts/push-boundary";
  import { bindForms } from "../scripts/forms";
  import { bindSavedActions } from "../scripts/catalog";
  import { bindBoundary } from "../scripts/boundary";
  import { bindNotifications } from "../scripts/notifications";
  import { bindClientErrorReporting } from "../scripts/client-errors";
  bindClientErrorReporting();
  bindNotifications();
  bindForms();
  bindPushLogout();
  bindBoundary();
  bindSavedActions();
</script>

<script>
  import { bindLoading } from "../scripts/loading";
  import { bindAccountMenus } from "../scripts/account-menu";
  bindLoading();
  bindAccountMenus();
</script>
